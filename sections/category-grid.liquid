{%- liquid
  assign category_count = 0
  for block in section.blocks
    assign category_collection = block.settings.collection
    if category_collection != blank and category_collection.id != blank and category_collection.url != blank
      assign category_count = category_count | plus: 1
    endif
  endfor
-%}
{%- if category_count > 0 or request.design_mode -%}
  <section class="section-space category-section" aria-labelledby="CategoryTitle-{{ section.id }}">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 id="CategoryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
        {%- if category_count > 0 -%}
          <a href="{{ routes.all_products_collection_url }}" class="text-link">Alle Produkte {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
      <div class="category-grid">
        {%- for block in section.blocks -%}
          {%- assign category_collection = block.settings.collection -%}
          {%- if category_collection != blank and category_collection.id != blank and category_collection.url != blank -%}
            <a href="{{ category_collection.url }}" class="category-card" {{ block.shopify_attributes }}>
              <div class="category-media"{% if category_collection.image == blank %} aria-hidden="true"{% endif %}>
                {%- if category_collection.image != blank -%}
                  {{ category_collection.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 900px) 25vw, 50vw', alt: category_collection.title }}
                {%- endif -%}
              </div>
              <div class="category-content">
                <h3>{{ category_collection.title | escape }}</h3>
                {%- if category_collection.description != blank -%}
                  <p>{{ category_collection.description | strip_html | truncate: 160 | escape_once }}</p>
                {%- endif -%}
                <span class="text-link category-arrow">Jetzt entdecken {% render 'icon', name: 'arrow' %}</span>
              </div>
            </a>
          {%- elsif request.design_mode -%}
            <div class="category-card" {{ block.shopify_attributes }}>
              <div class="category-content">
                <h3>Kollektion verknüpfen</h3>
                <p>Wählen Sie eine vorhandene Kollektion. Titel, Beschreibung, Bild und Ziel kommen direkt aus Shopify.</p>
              </div>
            </div>
          {%- endif -%}
        {%- else -%}
          {%- if request.design_mode -%}
            <p>Fügen Sie einen Kategorie-Block hinzu und wählen Sie eine Kollektion.</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Sortimentswelten",
  "settings": [
    {
      "type": "paragraph",
      "content": "Verknüpfen Sie jede Kategorie mit einer Shopify-Kollektion. Pflegen Sie Titel, Beschreibung und Bild bei dieser Kollektion. Nicht verknüpfte Blöcke erscheinen nur im Theme-Editor."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "SORGFÄLTIG AUSGEWÄHLT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Qualität, die zu Ihrem Leben passt."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Sortimentswelten"
    }
  ]
}
{% endschema %}

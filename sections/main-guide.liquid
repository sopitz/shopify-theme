{%- capture guide_advice_url -%}{%- render 'filial-anchor-url', url: section.settings.advice_url, fallback_url: '/pages/kontakt' -%}{%- endcapture -%}
{%- assign guide_advice_url = guide_advice_url | strip -%}
{%- capture guide_cards -%}
  {% for block in section.blocks %}
    {% assign target_collection = block.settings.collection %}
    {% if target_collection.id != blank and target_collection.url != blank %}
      <a class="need-card" href="{{ target_collection.url }}" {{ block.shopify_attributes }}><span class="need-icon">{% render 'icon', name: block.settings.icon %}</span><div><h2>{{ target_collection.title | escape }}</h2>{% if target_collection.description != blank %}<p>{{ target_collection.description | strip_html | strip | truncate: 180 | escape_once }}</p>{% endif %}<span class="text-link">{{ block.settings.label | escape }}</span></div>{% render 'icon', name: 'arrow' %}</a>
    {% elsif request.design_mode %}<article class="need-card" {{ block.shopify_attributes }}><div><h2>Collection auswählen</h2><p>Ordne diesem Einstieg eine vorhandene Collection zu.</p></div></article>{% endif %}
  {% endfor %}
{%- endcapture -%}
{%- assign guide_cards = guide_cards | strip -%}
<section class="section-space guide-section"><div class="container">
  <div class="page-intro"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ page.title | default: section.settings.heading | escape }}</h1><div>{{ section.settings.description }}</div></div>
  {% if guide_cards != blank %}<div class="needs-grid guide-grid">{{ guide_cards }}</div>{% elsif request.design_mode %}<p>Collections für den Produktberater auswählen.</p>{% endif %}
  {% if page.content != blank %}<div class="page-width rte">{{ page.content }}</div>{% endif %}
  <div class="guide-advice"><h2>{{ section.settings.advice_heading | escape }}</h2><p>{{ section.settings.advice_text | escape }}</p><a class="button" href="{{ guide_advice_url | escape }}">Persönliche Beratung {% render 'icon', name: 'arrow' %}</a><a class="text-link" href="/pages/filialubersicht#Filialen">Vor Ort ausprobieren</a></div>
</div></section>
{% schema %}
{
  "name": "Produktberater",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "IN RUHE DAS PASSENDE FINDEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Was ist dir im Alltag wichtig?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Einführung",
      "default": "<p>Starte mit deinem Anliegen. Entdecke passende Sortimentswelten und erfahre mehr über Material, Funktion und Anwendung.</p>"
    },
    {
      "type": "text",
      "id": "advice_heading",
      "label": "Beratungsüberschrift",
      "default": "Deine Bedürfnisse sind persönlich. Unsere Beratung auch."
    },
    {
      "type": "text",
      "id": "advice_text",
      "label": "Beratungstext",
      "default": "Wenn du bei der Auswahl Unterstützung wünschst, finden wir gemeinsam heraus, welches Produkt zu dir passt."
    },
    {
      "type": "url",
      "id": "advice_url",
      "label": "Kontaktseite"
    }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Anliegen",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Symbol",
          "default": "shoe",
          "options": [
            {
              "value": "shoe",
              "label": "Schuh"
            },
            {
              "value": "leaf",
              "label": "Bewegung"
            },
            {
              "value": "check",
              "label": "Regeneration"
            },
            {
              "value": "office",
              "label": "Arbeitsplatz"
            }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Linktext",
          "default": "Sortiment entdecken"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Ziel-Collection"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}

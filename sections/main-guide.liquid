{%- capture guide_advice_url -%}{%- render 'filial-anchor-url', url: section.settings.advice_url, fallback_url: '/pages/kontakt' -%}{%- endcapture -%}
{%- assign guide_advice_url = guide_advice_url | strip -%}
<section class="section-space guide-section"><div class="container"><div class="page-intro"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ page.title | default: section.settings.heading | escape }}</h1><div>{{ section.settings.description }}</div></div><div class="needs-grid guide-grid">{% for block in section.blocks %}<a class="need-card" href="{{ block.settings.url | default: '/collections/kybun-schuhe' | escape }}" {{ block.shopify_attributes }}><span class="need-icon">{% render 'icon', name: block.settings.icon %}</span><div><h2>{{ block.settings.title | escape }}</h2><p>{{ block.settings.description | escape }}</p><span class="text-link">{{ block.settings.label | escape }}</span></div>{% render 'icon', name: 'arrow' %}</a>{% endfor %}</div>{% if page.content != blank %}<div class="page-width rte">{{ page.content }}</div>{% endif %}<div class="guide-advice"><h2>{{ section.settings.advice_heading | escape }}</h2><p>{{ section.settings.advice_text | escape }}</p><a class="button" href="{{ guide_advice_url | escape }}">Persönliche Beratung {% render 'icon', name: 'arrow' %}</a><a class="text-link" href="/pages/filialubersicht#Filialen">Vor Ort ausprobieren</a></div></div></section>
{% schema %}
{
  "name": "Produktberater",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "IN RUHE DAS PASSENDE FINDEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Was ist Ihnen im Alltag wichtig?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Einführung",
      "default": "<p>Starten Sie mit Ihrem Anliegen. Entdecken Sie passende Sortimentswelten und erfahren Sie mehr über Material, Funktion und Anwendung.</p>"
    },
    {
      "type": "text",
      "id": "advice_heading",
      "label": "Beratungsüberschrift",
      "default": "Ihre Bedürfnisse sind persönlich. Unsere Beratung auch."
    },
    {
      "type": "text",
      "id": "advice_text",
      "label": "Beratungstext",
      "default": "Wenn Sie bei der Auswahl Unterstützung wünschen, finden wir gemeinsam heraus, welches Produkt zu Ihnen passt."
    },
    {
      "type": "url",
      "id": "advice_url",
      "label": "Kontaktseite"
    }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Anliegen",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Symbol",
          "default": "shoe",
          "options": [
            {
              "value": "shoe",
              "label": "Schuh"
            },
            {
              "value": "leaf",
              "label": "Bewegung"
            },
            {
              "value": "check",
              "label": "Regeneration"
            },
            {
              "value": "office",
              "label": "Arbeitsplatz"
            }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Überschrift",
          "default": "Angenehmer gehen"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Beschreibung",
          "default": "Komfort, Passform und ein Gehgefühl, das zu Ihnen passt."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Linktext",
          "default": "Schuhe entdecken"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Ziel"
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}

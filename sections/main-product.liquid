{%- capture resolved_product_color -%}{%- render 'product-color-label', color_product: product -%}{%- endcapture -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign primary_image = current_variant.featured_image | default: product.featured_media.preview_image | default: product.featured_image
  assign primary_alt = primary_image.alt | default: product.title
  assign model_title = product.metafields.upswing.model_name.value | default: product.title
  assign context_kind = product.metafields.upswing.product_kind.value | default: product.type
  assign consultation_url = section.settings.consultation_url | default: '/pages/filialubersicht'
  assign context_color = resolved_product_color | strip
  for option in product.options_with_values
    assign option_name = option.name | downcase | strip
    if option_name == 'farbe' or option_name == 'color' or option_name == 'colour'
      assign context_color = option.selected_value
      break
    endif
  endfor
-%}
{%- capture onsite_consultation_url -%}{%- render 'filial-anchor-url', url: consultation_url, fallback_url: '/pages/filialubersicht' -%}{%- endcapture -%}
{%- assign onsite_consultation_url = onsite_consultation_url | strip -%}
{%- capture product_knowledge -%}{% render 'product-knowledge', product: product, consultation_url: onsite_consultation_url %}{%- endcapture -%}
{%- assign product_knowledge = product_knowledge | strip -%}
{%- capture product_selection_guide -%}{%- render 'product-metafield-content', field: product.metafields.upswing.size_guide -%}{%- endcapture -%}
{%- capture product_main_category -%}{%- render 'product-main-category', product: product -%}{%- endcapture -%}
{%- assign product_main_category = product_main_category | strip -%}
<section class="product-section section-space" id="Product-{{ section.id }}" data-product-section data-product-media-context data-product-context-kind="{{ context_kind | escape }}" data-product-context-brand="{{ product.vendor | escape }}" data-section-id="{{ section.id }}" data-product-url="{{ product.url }}">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Brotkrumennavigation">
      <a href="{{ routes.root_url }}">Startseite</a><span aria-hidden="true">/</span>
      <a href="{{ collection.url | default: routes.all_products_collection_url }}">{{ collection.title | default: 'Alle Produkte' | escape }}</a><span aria-hidden="true">/</span>
      <span>{{ model_title | escape }}</span>
    </nav>
    <div class="product-detail" data-product-overview>
      <div class="product-gallery">
        <div class="product-gallery-sticky" data-product-gallery-sticky>
          <div class="product-main-media product-gallery-main">
            {%- if primary_image -%}
              {{ primary_image | image_url: width: 1400 | image_tag: widths: '480, 720, 1000, 1400', sizes: '(min-width: 900px) 52vw, 95vw', loading: 'eager', fetchpriority: 'high', alt: primary_alt, data-product-image: '' }}
            {%- else -%}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </div>
          {%- if product.images.size > 1 -%}
            <div class="product-thumbnails" aria-label="Produktbilder">
              {%- for image in product.images -%}
                {%- assign gallery_alt = image.alt | default: product.title -%}
                <a class="product-thumbnail{% if image.id == primary_image.id %} is-selected{% endif %}" href="{{ image | image_url: width: 1600 }}" data-gallery-image="{{ image | image_url: width: 1400 }}" data-gallery-alt="{{ image.alt | default: product.title | escape }}" aria-label="Bild {{ forloop.index }} von {{ product.images.size }} ansehen">
                  {{ image | image_url: width: 360 | image_tag: loading: 'lazy', alt: gallery_alt, width: 180, height: 180 }}
                </a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
        {%- for media in product.media -%}
          {%- unless media.media_type == 'image' -%}
            <div class="product-extra-media">
              {%- case media.media_type -%}
                {%- when 'video' -%}{{ media | video_tag: controls: true, preload: 'none', image_size: '800x' }}
                {%- when 'external_video' -%}{{ media | external_video_tag: loading: 'lazy' }}
                {%- when 'model' -%}{{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
              {%- endcase -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
      <div class="product-info">
        <p class="eyebrow">{{ product.vendor | escape }}{% if context_kind != blank %} · {{ context_kind | escape }}{% endif %}</p>
        <h1>{{ model_title | escape }}</h1>
        <p class="product-sku" data-product-sku-row{% if current_variant.sku == blank %} hidden{% endif %}>Artikelnr.: <span data-product-sku>{{ current_variant.sku | escape }}</span></p>
        {% render 'product-intro', product: product %}
        <div class="product-price product-price-large">{% render 'price', product: product, variant: current_variant, live: true %}</div>
        <p class="price-tax">{% if cart.taxes_included %}Inklusive Steuern.{% else %}Steuern werden an der Kasse berechnet.{% endif %} {% if shop.shipping_policy != blank %}<a href="{{ shop.shipping_policy.url }}">Versandbedingungen</a>{% else %}Versand wird an der Kasse berechnet.{% endif %}</p>
        {%- capture product_benefit_items -%}
          {%- if product.metafields.upswing.benefits.type == 'list.single_line_text_field' -%}
            {%- for benefit in product.metafields.upswing.benefits.value -%}
              {%- assign benefit_json = benefit | json -%}
              {%- assign benefit_opening = benefit_json | slice: 0, 1 -%}
              {%- if benefit_opening == '"' -%}
                {%- assign benefit_text = benefit | replace: ' ', ' ' | strip -%}
                {%- if benefit_text != blank -%}<li>{% render 'icon', name: 'check' %}<span>{{ benefit_text | escape }}</span></li>{%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endcapture -%}
        {%- assign product_benefit_items = product_benefit_items | strip -%}
        {%- if product_benefit_items != blank -%}<ul class="product-benefits">{{ product_benefit_items }}</ul>{%- endif -%}
        {% render 'product-model-colors', product: product %}
        {%- form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '', data-product-id: product.id, data-product-url: product.url, data-section-id: section.id, data-high-variants: product.variants_count -%}
          {{ form.errors | default_errors }}
          <script type="application/json" data-variants>
            [
              {%- if product.variants_count <= 250 -%}
                {%- for variant in product.variants -%}
                  {%- assign variant_image_alt = variant.featured_image.alt | default: model_title -%}
                  {"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare_at_price":{{ variant.compare_at_price | json }},"price_formatted":{{ variant.price | money_with_currency | json }},"compare_at_formatted":{{ variant.compare_at_price | money_with_currency | json }},"sku":{{ variant.sku | json }},"quantity_rule":{{ variant.quantity_rule | json }},"image":{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1400 | json }}{% else %}null{% endif %},"image_alt":{{ variant_image_alt | json }},"delivery":{% render 'product-delivery', product: product, variant: variant, output: 'json' %}}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              {%- endif -%}
            ]
          </script>
          {%- unless product.has_only_default_variant -%}
            {%- if product_selection_guide != blank -%}<a class="product-selection-help" href="#ProductSizeGuide">{% if product_main_category == 'footwear' %}Hilfe bei der Grösse{% else %}Hilfe bei der Auswahl{% endif %}</a>{%- endif -%}
            <div class="enhanced-variant-picker enhanced-options">
              {%- for option in product.options_with_values -%}
                {%- assign option_name = option.name | downcase | strip -%}
                <fieldset class="product-option option-group" data-option-group="{{ option.position }}" data-option-name="{{ option.name | escape }}">
                  <legend>{{ option.name | escape }} <span data-option-selected="{{ option.position }}">{{ option.selected_value | escape }}</span></legend>
                  <div class="variant-buttons option-values">
                    {%- for value in option.values -%}
                      {%- capture option_swatch -%}{% render 'option-value-paint', product: product, option: option, value: value %}{%- endcapture -%}
                      {%- assign option_swatch_image = value.swatch.image -%}
                      <div class="variant-button{% unless value.available %} is-unavailable{% endunless %}">
                        <input type="radio" id="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-option-select data-option-position="{{ option.position }}" data-option-value-id="{{ value.id }}"{% if value.product_url %} data-option-product-url="{{ value.product_url }}"{% endif %}{% if value.selected %} checked{% endif %}>
                        <label class="variant-label" for="Option-{{ section.id }}-{{ option.position }}-{{ forloop.index }}">{% if option_swatch_image %}{{ option_swatch_image | image_url: width: 34 | image_tag: loading: 'lazy', width: 17, height: 17, class: 'variant-color-dot', alt: '' }}{% elsif option_swatch != blank %}<span class="variant-color-dot" style="--swatch-color: {{ option_swatch | escape }}"></span>{% endif %}{{ value | escape }}</label>
                      </div>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}
          {%- if product.variants_count <= 250 and product.has_only_default_variant == false -%}
            <div data-variant-fallback class="variant-fallback">
              <label for="Variant-{{ section.id }}">Variante wählen</label>
              <select name="id" id="Variant-{{ section.id }}" data-variant-id>
                {%- for variant in product.variants -%}<option value="{{ variant.id }}"{% if variant.id == current_variant.id %} selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money_with_currency }}{% unless variant.available %} — nicht verfügbar{% endunless %}</option>{%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id{% if current_variant == blank %} disabled{% endif %}>
          {%- endif -%}
          {%- if product.selling_plan_groups.size > 0 -%}
            <label for="SellingPlan-{{ section.id }}">Kaufoption</label>
            <select name="selling_plan" id="SellingPlan-{{ section.id }}"{% if product.requires_selling_plan %} required{% endif %}>
              {%- unless product.requires_selling_plan -%}<option value="">Einmaliger Kauf</option>{%- endunless -%}
              {%- for group in product.selling_plan_groups -%}<optgroup label="{{ group.name | escape }}">{%- for plan in group.selling_plans -%}<option value="{{ plan.id }}"{% if plan.id == product.selected_selling_plan.id %} selected{% endif %}>{{ plan.name | escape }}</option>{%- endfor -%}</optgroup>{%- endfor -%}
            </select>
          {%- endif -%}
          <div class="product-quantity">
            <label for="Quantity-{{ section.id }}">Anzahl</label>
            <input id="Quantity-{{ section.id }}" type="number" name="quantity" value="{{ current_variant.quantity_rule.min | default: 1 }}" min="{{ current_variant.quantity_rule.min | default: 1 }}" step="{{ current_variant.quantity_rule.increment | default: 1 }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %} inputmode="numeric" data-product-quantity>
          </div>
          {% render 'product-delivery', product: product, variant: current_variant %}
          <button class="button product-add-button enhanced-add-button" type="submit" name="add"{% unless current_variant.available %} disabled{% endunless %}><span data-add-label>{% if current_variant.available %}In den Warenkorb{% else %}Nicht verfügbar{% endif %}</span>{% render 'icon', name: 'bag' %}</button>
          <noscript>
            <style>.enhanced-variant-picker,.enhanced-add-button{display:none!important}</style>
            {%- if product.variants_count > 250 -%}
              <p>Bitte wähle deine Variante. Nach jeder Auswahl wird die Seite aktualisiert.</p>
              {%- for option in product.options_with_values -%}
                <div class="native-option-links"><strong>{{ option.name | escape }}</strong>
                  {%- for value in option.values -%}
                    {%- capture option_ids -%}{%- for other_option in product.options_with_values -%}{%- if other_option.position == option.position -%}{{ value.id }}{%- else -%}{%- for selected_value in other_option.values -%}{%- if selected_value.selected -%}{{ selected_value.id }}{%- break -%}{%- endif -%}{%- endfor -%}{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}{%- endcapture -%}
                    <a class="variant-native-link{% if value.selected %} is-selected{% endif %}" href="{{ product.url }}?option_values={{ option_ids }}">{{ value | escape }}</a>
                  {%- endfor -%}
                </div>
              {%- endfor -%}
            {%- endif -%}
            <button class="button product-add-button" type="submit" name="add"{% if product.variants_count > 250 %}{% unless current_variant.available %} disabled{% endunless %}{% else %}{% unless product.available %} disabled{% endunless %}{% endif %}>In den Warenkorb</button>
          </noscript>
          <div class="product-form-error" data-product-error role="alert" hidden></div>
        {%- endform -%}
        <div class="product-purchase-notes">
          {%- if shop.shipping_policy != blank -%}<p>{% render 'icon', name: 'truck' %}<a href="{{ shop.shipping_policy.url }}">Versandbedingungen</a></p>{%- endif -%}
          {%- if product.metafields.upswing.delivery_note != blank -%}<div class="delivery-note">{{ product.metafields.upswing.delivery_note | metafield_tag }}</div>{%- endif -%}
          {%- if shop.refund_policy != blank -%}<p>{% render 'icon', name: 'return' %}<a href="{{ shop.refund_policy.url }}">Rückgabe- und Erstattungsbedingungen</a></p>{%- endif -%}
        </div>
        <div class="product-consultation">
          {% render 'icon', name: 'phone' %}
          <div><strong>Passt dieses Produkt zu dir?</strong><p>Wir helfen dir bei Auswahl, Passform und Anwendung.</p><a class="text-link" href="{{ onsite_consultation_url | escape }}">Persönliche Beratung finden</a></div>
        </div>
        {%- if section.settings.b2b_url != blank -%}<p class="product-b2b-link">Für Mitarbeitende einkaufen? <a href="{{ section.settings.b2b_url }}">Firmenberatung anfragen</a></p>{%- endif -%}
        {%- if product_knowledge != blank -%}<a class="text-link description-jump" href="#ProductInformation">Alle Produktinformationen lesen {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </div>
    </div>
    {%- if primary_image -%}
      <aside class="product-image-preview" data-product-image-preview aria-label="Produktauswahl und Warenkorb beim Lesen" hidden>
        <button class="product-image-preview-button" type="button" data-image-preview-top aria-label="Zur Bildergalerie von {{ model_title | escape }} zurück">
          <span class="product-image-preview-media">{{ primary_image | image_url: width: 480 | image_tag: widths: '120, 240, 480', sizes: '120px', width: 240, height: 240, loading: 'lazy', alt: primary_alt, data-context-image: '' }}</span>
          <span class="product-image-preview-copy">
            <strong>{{ model_title | escape }}</strong>
            <span data-context-color{% if context_color == blank %} hidden{% endif %}>{{ context_color | escape }}</span>
            <span class="product-image-preview-hint">Zur Bildergalerie ↑</span>
          </span>
        </button>
        <div class="product-context-price"><strong data-context-price>{{ current_variant.price | money_with_currency }}</strong><span data-context-availability></span></div>
        <div class="product-context-purchase" data-context-purchase>
          <div class="product-context-options" data-context-options></div>
          <label class="product-context-quantity"><span>Anzahl</span><input type="number" value="{{ current_variant.quantity_rule.min | default: 1 }}" min="{{ current_variant.quantity_rule.min | default: 1 }}" inputmode="numeric" data-context-quantity></label>
          <button class="button product-context-add" type="button" data-context-add{% unless current_variant.available %} disabled{% endunless %}><span data-context-add-label>In den Warenkorb</span>{% render 'icon', name: 'bag' %}</button>
        </div>
        <p class="product-context-error" data-context-error role="alert" hidden></p>
      </aside>
    {%- endif -%}
    {{ product_knowledge }}
    <div class="product-accordions product-policies">
        {%- if shop.shipping_policy != blank or shop.refund_policy != blank -%}<details class="product-accordion"><summary>Versand & Rückgabe {% render 'icon', name: 'plus' %}</summary><div class="rte">{% if shop.shipping_policy != blank %}{{ shop.shipping_policy.body }}<p><a href="{{ shop.shipping_policy.url }}">Vollständige Versandbedingungen</a></p>{% endif %}{% if shop.refund_policy != blank %}{{ shop.refund_policy.body }}<p><a href="{{ shop.refund_policy.url }}">Rückgabe- und Erstattungsbedingungen</a></p>{% endif %}</div></details>{%- endif -%}
        {%- for block in section.blocks -%}{%- case block.type -%}{%- when '@app' -%}{% render block %}{%- when 'information' -%}<details class="product-accordion" {{ block.shopify_attributes }}><summary>{{ block.settings.heading | escape }} {% render 'icon', name: 'plus' %}</summary><div class="rte">{{ block.settings.content }}</div></details>{%- endcase -%}{%- endfor -%}
    </div>
    {%- if product.metafields.upswing.related_products.value != blank -%}
      <div class="related-products"><div class="section-heading"><div><p class="eyebrow">Sinnvoll ergänzen</p><h2>Passt dazu.</h2></div></div><div class="product-grid">{%- for related in product.metafields.upswing.related_products.value limit: 4 -%}{% render 'product-card', product: related %}{%- endfor -%}</div></div>
    {%- endif -%}
  </div>
</section>
<script type="application/ld+json">{{ product | structured_data }}</script>
{% schema %}
{
  "name": "Produkt & Beratung",
  "settings": [
    {
      "type": "url",
      "id": "consultation_url",
      "label": "Beratung / Filialen"
    },
    {
      "type": "url",
      "id": "b2b_url",
      "label": "Firmenberatung"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "information",
      "name": "Zusätzliche Information",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Weitere Informationen"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Inhalt"
        }
      ]
    }
  ]
}
{% endschema %}

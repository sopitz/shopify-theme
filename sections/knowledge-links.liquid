{%- assign knowledge_more_url = section.settings.more_url | default: '/pages/produktberater' -%}
<section class="section-space knowledge-section" aria-labelledby="Knowledge-{{ section.id }}">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="Knowledge-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>{% if knowledge_more_url != blank %}<a class="text-link" href="{{ knowledge_more_url }}">{{ section.settings.more_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
    <div class="knowledge-grid">
      {% for block in section.blocks %}<article class="knowledge-card" {{ block.shopify_attributes }}><span class="knowledge-number">0{{ forloop.index }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.description | escape }}</p>{% if block.settings.url != blank %}<a class="text-link" href="{{ block.settings.url }}">Mehr erfahren {% render 'icon', name: 'arrow' %}</a>{% endif %}</article>{% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Wissen & Orientierung",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "WISSEN GIBT SICHERHEIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Gut verstehen. Besser entscheiden."
    },
    {
      "type": "url",
      "id": "more_url",
      "label": "Weiterführende Seite"
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Linktext",
      "default": "Orientierung finden"
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Ratgeber",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titel",
          "default": "Gut informiert entscheiden"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Beschreibung"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Ratgeberseite"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Wissen & Orientierung"
    }
  ]
}
{% endschema %}

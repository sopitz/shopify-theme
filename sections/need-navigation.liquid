<section class="section-space needs-section" id="anliegen" aria-labelledby="NeedsTitle-{{ section.id }}">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 id="NeedsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      <p class="section-intro">{{ section.settings.intro | escape }}</p>
    </div>
    <div class="needs-grid topic-grid">
      {% for block in section.blocks %}
        {% assign topic_image_alt = block.settings.image_alt | default: block.settings.image.alt | default: block.settings.title %}
        <a class="topic-card" href="{{ block.settings.url | default: '/pages/fersensporn-und-andere-fussschmerzen' | escape }}" {{ block.shopify_attributes }}>
          <div class="topic-media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000, 1200', sizes: '(min-width: 1000px) 25vw, (min-width: 600px) 50vw, 100vw', alt: topic_image_alt }}
            {% elsif block.settings.fallback_image != blank %}
              <img src="{{ block.settings.fallback_image | asset_url }}" alt="{{ topic_image_alt | escape }}" width="720" height="480" loading="lazy">
            {% else %}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-image' }}
            {% endif %}
          </div>
          <div class="topic-content">
            {% if block.settings.topic_label != blank %}<p class="topic-label">{{ block.settings.topic_label | escape }}</p>{% endif %}
            <h3 class="topic-title">{{ block.settings.title | escape }}</h3>
            <p class="topic-description">{{ block.settings.description | escape }}</p>
            {% if block.settings.product_hint != blank %}<p class="topic-products">{{ block.settings.product_hint | escape }}</p>{% endif %}
            <span class="text-link">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</span>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{%- capture topic_cards -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign target = block.settings.page
      assign topic_description = target.content
      assign topic_image = target.metafields.upswing.teaser_image.value.preview_image
      if block.settings.image != blank
        assign topic_image = block.settings.image
      endif
      if block.settings.target_type == 'collection'
        assign target = block.settings.collection
        assign topic_description = target.description
        assign topic_image = target.image
      endif
    -%}
    {%- if target.id != blank and target.url != blank -%}
      {%- assign topic_image_alt = topic_image.alt | default: target.title -%}
      <a class="topic-card" href="{{ target.url }}" {{ block.shopify_attributes }}>
        <div class="topic-media">
          {% if topic_image != blank %}{{ topic_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000, 1200', sizes: '(min-width: 1000px) 25vw, (min-width: 600px) 50vw, 100vw', alt: topic_image_alt }}{% else %}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-image' }}{% endif %}
        </div>
        <div class="topic-content">
          {% if block.settings.topic_label != blank %}<p class="topic-label">{{ block.settings.topic_label | escape }}</p>{% endif %}
          <h3 class="topic-title">{{ target.title | escape }}</h3>
          {% if topic_description != blank %}<p class="topic-description">{{ topic_description | strip_html | strip | truncate: 180 | escape_once }}</p>{% endif %}
          <span class="text-link">{{ block.settings.link_label | default: 'Entdecken' | escape }} {% render 'icon', name: 'arrow' %}</span>
        </div>
      </a>
    {%- elsif request.design_mode -%}
      <article class="topic-card" {{ block.shopify_attributes }}><div class="topic-content"><h3>Themenziel auswählen</h3><p>Wählen Sie eine vorhandene Shopify-Seite oder Collection.</p></div></article>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign topic_cards = topic_cards | strip -%}
{%- if topic_cards != blank or request.design_mode -%}
<section class="section-space needs-section" id="anliegen" aria-labelledby="NeedsTitle-{{ section.id }}">
  <div class="container">
    <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="NeedsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div><p class="section-intro">{{ section.settings.intro | escape }}</p></div>
    {% if topic_cards != blank %}<div class="needs-grid topic-grid">{{ topic_cards }}</div>{% else %}<p>Themen-Seiten oder Collections auswählen.</p>{% endif %}
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Einstieg nach Bedürfnis",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "IHR ANLIEGEN. IHR EINSTIEG."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Was möchten Sie verbessern?"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Einführung",
      "default": "Beginnen Sie bei Ihrem Anliegen. Wir erklären die Möglichkeiten und führen Sie zum passenden Sortiment."
    }
  ],
  "blocks": [
    {
      "type": "need",
      "name": "Themenkarte",
      "settings": [
        {
          "type": "select",
          "id": "target_type",
          "label": "Zieltyp",
          "default": "page",
          "options": [
            {
              "value": "page",
              "label": "Shopify-Seite"
            },
            {
              "value": "collection",
              "label": "Collection"
            }
          ]
        },
        {
          "type": "page",
          "id": "page",
          "label": "Themen-Seite"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Optionales redaktionelles Seitenbild",
          "info": "Nur für Seiten. Collection-Bilder stammen aus der Collection."
        },
        {
          "type": "text",
          "id": "topic_label",
          "label": "Optionale redaktionelle Dachzeile"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Linktext",
          "default": "Entdecken"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Einstieg nach Bedürfnis",
      "blocks": [
        {
          "type": "need"
        }
      ]
    }
  ]
}
{% endschema %}

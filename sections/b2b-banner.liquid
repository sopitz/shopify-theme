<section class="section-space b2b-section" aria-labelledby="BusinessTitle-{{ section.id }}"><div class="container b2b-grid"><div class="b2b-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="BusinessTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div>{{ section.settings.description }}</div><ul class="check-list">{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text | escape }}</span></li>{% endfor %}</ul><a class="button" href="{{ section.settings.url | default: '/pages/firmenkunden' | escape }}">{{ section.settings.label | escape }} {% render 'icon', name: 'arrow' %}</a></div><div class="b2b-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 900px) 50vw, 100vw' }}{% else %}<img src="{{ 'workplace.jpg' | asset_url }}" alt="Aktiver Arbeitsplatz mit einer kybun Stehmatte" width="1200" height="800" loading="lazy">{% endif %}</div></div></section>
{% schema %}
{
  "name": "Für Unternehmen",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "GESUNDHEIT AM ARBEITSPLATZ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Gutes für Ihr Team. Gemeinsam ausgewählt."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschreibung",
      "default": "<p>Ob für langes Stehen, bewegte Pausen oder bewusstes Wohlbefinden: Finden Sie hochwertige Produkte für Ihre Mitarbeitenden. Wir unterstützen Sie von der Auswahl bis zur individuellen Offerte.</p>"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button",
      "default": "Lösungen für Unternehmen"
    },
    {
      "type": "url",
      "id": "url",
      "label": "Ziel"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Vorteil",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Persönliche Beratung für Ihr Unternehmen"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Für Unternehmen"
    }
  ]
}
{% endschema %}

{%- capture onsite_primary_url -%}{%- render 'filial-anchor-url', url: section.settings.primary_url, fallback_url: '/pages/filialubersicht#Filialen' -%}{%- endcapture -%}
{%- assign onsite_primary_url = onsite_primary_url | strip -%}
<section class="section-space advice-section" aria-labelledby="AdviceTitle-{{ section.id }}"><div class="container advice-grid"><div class="advice-media">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 900px) 50vw, 100vw' }}{% else %}<img src="{{ 'shop-thun.jpg' | asset_url }}" alt="upswing Filiale – Produkte vor Ort entdecken und anprobieren" width="1200" height="800" loading="lazy">{% endif %}<span class="image-caption">{{ section.settings.caption | escape }}</span></div><div class="advice-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="AdviceTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><div>{{ section.settings.description }}</div><ul class="check-list">{% for block in section.blocks %}<li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text | escape }}</span></li>{% endfor %}</ul><div class="hero-buttons"><a href="{{ onsite_primary_url | escape }}" class="button">{{ section.settings.primary_label | escape }} {% render 'icon', name: 'arrow' %}</a><a href="{{ section.settings.secondary_url | default: '/pages/kontakt' | escape }}" class="text-link">{{ section.settings.secondary_label | escape }}</a></div></div></div></section>
{% schema %}
{
  "name": "Persönliche Beratung",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Filialbild"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Bildlegende",
      "default": "Persönlich vor Ort in Thun"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "WIR NEHMEN UNS ZEIT FÜR SIE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Eine gute Entscheidung beginnt mit guter Beratung."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Beschreibung",
      "default": "<p>Welcher Schuh passt zu Ihrem Fuss? Welches Produkt unterstützt Ihren Alltag? Wir hören zu, erklären die Unterschiede und begleiten Sie bei Ihrer Wahl.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Erster Button",
      "default": "Filiale in Ihrer Nähe finden"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Erstes Ziel"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Zweiter Link",
      "default": "Kontakt aufnehmen"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Zweites Ziel"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Vorteil",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ausprobieren statt nur vergleichen"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Persönliche Beratung"
    }
  ]
}
{% endschema %}

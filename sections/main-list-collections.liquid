<section class="section-space">
  <div class="container"><p class="eyebrow">Entdecken Sie Ihre Möglichkeiten</p><h1>Unser Sortiment</h1><p class="collection-description">Wählen Sie den Bereich, der zu Ihrem Alltag passt. Wir beraten Sie gerne persönlich.</p>
    {%- paginate collections by 24 -%}<div class="category-grid">{%- for collection in collections -%}<a class="category-card" href="{{ collection.url }}"><div class="category-image">{% assign category_image = collection.image | default: collection.products.first.featured_image %}{% if category_image %}{{ category_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 900px) 24vw, 45vw', alt: collection.title }}{% else %}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}</div><div class="category-card-copy category-copy"><h2>{{ collection.title | escape }}</h2><span class="text-link">Entdecken {% render 'icon', name: 'arrow' %}</span></div></a>{%- else -%}<div class="empty-state"><p>Das Sortiment wird gerade zusammengestellt.</p><a class="button" href="{{ routes.all_products_collection_url }}">Alle Produkte ansehen</a></div>{%- endfor -%}</div>{% if paginate.pages > 1 %}<nav class="pagination" aria-label="Weitere Kategorien">{{ paginate | default_pagination: next: 'Weiter', previous: 'Zurück' }}</nav>{% endif %}{%- endpaginate -%}
  </div>
</section>
{% schema %}{
  "name": "Kollektionen",
  "settings": []
}{% endschema %}

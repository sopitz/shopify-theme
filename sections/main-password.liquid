<section class="section-space password-section"><div class="container page-width"><img src="{{ 'upswing-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="180" height="52"><p class="eyebrow">{{ shop.name | escape }}</p><h1>{{ section.settings.heading | escape }}</h1>{% if shop.password_message != blank %}<div class="rte">{{ shop.password_message }}</div>{% else %}<p>{{ section.settings.description | escape }}</p>{% endif %}<details><summary>Zugang mit Passwort</summary>{% form 'storefront_password', class: 'contact-form' %}{% if form.errors %}<div role="alert">{{ form.errors | default_errors }}</div>{% endif %}<div class="field"><label for="StorePassword">Passwort</label><input type="password" name="password" id="StorePassword" autocomplete="current-password" required></div><button class="button" type="submit">Shop öffnen</button>{% endform %}</details><p><a class="text-link" href="/admin">Shop verwalten</a></p></div></section>
{% schema %}
{
  "name": "Passwortseite",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bald wieder persönlich für dich da."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Beschreibung",
      "default": "Wir arbeiten an unserem Shop. Vielen Dank für deine Geduld."
    }
  ]
}
{% endschema %}

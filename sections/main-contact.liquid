{%- capture migrated_page -%}{% render 'migrated-page-content', page: page, section: section, include_editorial: true %}{%- endcapture -%}
{%- assign migrated_page = migrated_page | strip -%}
{%- if migrated_page != blank -%}
  {{ migrated_page }}
{%- else -%}
{% render 'native-contact-page', page: page, section: section %}
{%- endif -%}
{% schema %}
{
  "name": "Kontakt & Beratung",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "WIR SIND FÜR SIE DA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Wie können wir helfen?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Einführung",
      "default": "<p>Du hast eine Frage zu einem Produkt, zur passenden Grösse oder zu deiner Bestellung? Schreib uns. Wir beraten dich gerne.</p>"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Formularüberschrift",
      "default": "Deine Nachricht an uns"
    }
  ]
}
{% endschema %}

{{ 'consultation-bookings.css' | asset_url | stylesheet_tag }}
{%- assign consultation_heading = section.settings.heading | default: page.title | default: 'Dein Beratungstermin' -%}
{%- assign location_keys = 'thun,zurich,winterthur,ruti,basel' | split: ',' -%}
{%- capture booking_cards -%}
  {%- for block in section.blocks -%}
    {%- capture booking_links -%}
      {%- for location_key in location_keys -%}
        {%- assign url_key = location_key | append: '_url' -%}
        {%- assign booking_url = block.settings[url_key] | strip -%}
        {%- assign booking_scheme = booking_url | slice: 0, 8 -%}
        {%- if booking_scheme == 'https://' -%}
          {%- case location_key -%}{%- when 'thun' -%}{%- assign location_label = 'Thun' -%}{%- when 'zurich' -%}{%- assign location_label = 'Zürich' -%}{%- when 'winterthur' -%}{%- assign location_label = 'Winterthur' -%}{%- when 'ruti' -%}{%- assign location_label = 'Rüti ZH' -%}{%- when 'basel' -%}{%- assign location_label = 'Basel' -%}{%- endcase -%}
          <li><a href="{{ booking_url | escape }}" target="_blank" rel="noopener noreferrer"><span>{{ location_label }}</span><span class="visually-hidden"> – {{ block.settings.title | escape }} buchen, öffnet eine neue Seite</span>{% render 'icon', name: 'arrow' %}</a></li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign booking_links = booking_links | strip -%}
    {%- if block.type == 'booking' and block.settings.title != blank and booking_links != blank -%}
      <article class="consultation-booking-card" aria-labelledby="ConsultationTopic-{{ section.id }}-{{ block.id }}" {{ block.shopify_attributes }}>
        <div class="consultation-booking-intro">
          <span class="consultation-booking-icon" aria-hidden="true">{% render 'icon', name: block.settings.icon %}</span>
          <h2 id="ConsultationTopic-{{ section.id }}-{{ block.id }}">{{ block.settings.title | escape }}</h2>
          {% if block.settings.description != blank %}<div class="rte">{{ block.settings.description }}</div>{% endif %}
        </div>
        <div class="consultation-booking-locations"><h3>Filiale wählen und Termin buchen</h3><ul>{{ booking_links }}</ul></div>
      </article>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign booking_cards = booking_cards | strip -%}
<section class="consultation-bookings section-space" id="ConsultationBookings-{{ section.id }}">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Brotkrumennavigation"><a href="{{ routes.root_url }}">Startseite</a><span aria-hidden="true">/</span><span>{{ consultation_heading | escape }}</span></nav>
    <header class="consultation-bookings-header"><p class="eyebrow">Persönlich vor Ort</p><h1>{{ consultation_heading | escape }}</h1>{% if section.settings.intro != blank %}<div class="rte">{{ section.settings.intro }}</div>{% endif %}</header>
    {% if booking_cards != blank %}
      <div class="consultation-bookings-grid">{{ booking_cards }}</div>
      <p class="consultation-bookings-note">Die Terminwahl öffnet die Buchungsseite der gewählten Filiale in einem neuen Fenster.</p>
    {% elsif request.design_mode %}
      <div class="consultation-bookings-empty"><h2>Buchungsmöglichkeiten verknüpfen</h2><p>Füge einen Beratungsblock hinzu und hinterlege die bestehenden HTTPS-Buchungslinks der Filialen.</p></div>
    {% else %}
      <p>Für einen persönlichen Beratungstermin wende dich direkt an unsere Filialen.</p>
    {% endif %}
    <div class="consultation-bookings-help"><div><h2>Du hast eine andere Frage?</h2><p>Unsere Filialen helfen dir auch bei Fragen zu Produkten und Bestellungen.</p></div><a class="text-link" href="/pages/filialubersicht#Filialen">Filialen und Kontakt {% render 'icon', name: 'arrow' %}</a></div>
  </div>
</section>
{% schema %}
{
  "name": "Beratungstermine",
  "max_blocks": 6,
  "settings": [
    {"type": "text", "id": "heading", "label": "Überschrift", "default": "Dein Beratungstermin"},
    {"type": "richtext", "id": "intro", "label": "Einführung", "default": "<p>Wähle dein Thema und die passende Filiale. Auf unserer Buchungsseite kannst du deinen Termin auswählen.</p>"}
  ],
  "blocks": [{
    "type": "booking",
    "name": "Beratung",
    "settings": [
      {"type": "text", "id": "title", "label": "Thema"},
      {"type": "richtext", "id": "description", "label": "Beschreibung"},
      {"type": "select", "id": "icon", "label": "Symbol", "default": "leaf", "options": [{"value":"leaf","label":"Regeneration"},{"value":"move","label":"Bewegung"},{"value":"moon","label":"Schlaf"}]},
      {"type": "url", "id": "thun_url", "label": "Buchungslink Thun"},
      {"type": "url", "id": "zurich_url", "label": "Buchungslink Zürich"},
      {"type": "url", "id": "winterthur_url", "label": "Buchungslink Winterthur"},
      {"type": "url", "id": "ruti_url", "label": "Buchungslink Rüti ZH"},
      {"type": "url", "id": "basel_url", "label": "Buchungslink Basel"}
    ]
  }],
  "presets": [{"name":"Beratungstermine"}]
}
{% endschema %}

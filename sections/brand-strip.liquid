{%- liquid
  assign brand_count = 0
  for block in section.blocks
    assign brand_collection = block.settings.collection
    if block.settings.target_type == 'page'
      assign brand_collection = block.settings.page
    endif
    if brand_collection != blank and brand_collection.id != blank and brand_collection.url != blank
      assign brand_count = brand_count | plus: 1
    endif
  endfor
-%}
{%- if brand_count > 0 or request.design_mode -%}
  <section class="brand-section" aria-labelledby="BrandTitle-{{ section.id }}">
    <div class="container">
      <div class="section-heading"><h2 id="BrandTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
      <div class="brand-strip">
        {%- for block in section.blocks -%}
          {%- liquid
            assign brand_collection = block.settings.collection
            if block.settings.target_type == 'page'
              assign brand_collection = block.settings.page
            endif
          -%}
          {%- if brand_collection != blank and brand_collection.id != blank and brand_collection.url != blank -%}
            {%- liquid
              assign brand_image = nil
              if block.settings.target_type == 'page'
                assign brand_image = block.settings.logo
              else
                assign brand_image = brand_collection.image
                assign brand_logo = brand_collection.metafields.upswing.brand_logo.value
                if brand_logo.media_type == 'image' and brand_logo.preview_image != blank
                  assign brand_image = brand_logo.preview_image
                endif
              endif
            -%}
            <a href="{{ brand_collection.url }}" class="brand-logo" aria-label="{{ brand_collection.title | escape }} entdecken" {{ block.shopify_attributes }}>
              {%- if brand_image != blank -%}
                {{ brand_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '160, 240, 320, 480', sizes: '(min-width: 1000px) 15vw, (min-width: 600px) 30vw, 45vw', alt: brand_collection.title }}
              {%- else -%}
                <span class="brand-name">{{ brand_collection.title | escape }}</span>
              {%- endif -%}
            </a>
          {%- elsif request.design_mode -%}
            <div {{ block.shopify_attributes }}>
              <p>Marken-Seite oder Kollektion verknüpfen</p>
              <p>Wähle das Markenziel. Für eine Markenseite wähle zusätzlich das Logo.</p>
            </div>
          {%- endif -%}
        {%- else -%}
          {%- if request.design_mode -%}
            <p>Füge einen Marken-Block hinzu und wähle die zugehörige Seite oder Kollektion.</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Unsere Lieblingsmarken",
  "settings": [
    {
      "type": "paragraph",
      "content": "Jede Marke führt auf ihre Shopify-Markenseite oder Kollektion. Markenseiten verwenden das gewählte Logo. Kollektionen verwenden upswing.brand_logo, ersatzweise Kollektionsbild oder Titel. Nicht verknüpfte Ziele bleiben im Shop verborgen."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Unsere Lieblingsmarken"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marke",
      "settings": [
        {
          "type": "select",
          "id": "target_type",
          "label": "Markenziel",
          "default": "collection",
          "options": [
            {
              "value": "collection",
              "label": "Kollektion"
            },
            {
              "value": "page",
              "label": "Markenseite"
            }
          ]
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Markenseite"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo für Markenseite"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Unsere Lieblingsmarken"
    }
  ]
}
{% endschema %}

{%- liquid
  assign brand_count = 0
  for block in section.blocks
    assign brand_collection = block.settings.collection
    if brand_collection != blank and brand_collection.id != blank and brand_collection.url != blank
      assign brand_count = brand_count | plus: 1
    endif
  endfor
-%}
{%- if brand_count > 0 or request.design_mode -%}
  <section class="brand-section" aria-labelledby="BrandTitle-{{ section.id }}">
    <div class="container">
      <p class="eyebrow" id="BrandTitle-{{ section.id }}">{{ section.settings.heading | escape }}</p>
      <div class="brand-strip">
        {%- for block in section.blocks -%}
          {%- assign brand_collection = block.settings.collection -%}
          {%- if brand_collection != blank and brand_collection.id != blank and brand_collection.url != blank -%}
            {%- liquid
              assign brand_image = brand_collection.image
              assign brand_logo = brand_collection.metafields.upswing.brand_logo.value
              if brand_logo.media_type == 'image' and brand_logo.preview_image != blank
                assign brand_image = brand_logo.preview_image
              endif
            -%}
            <a href="{{ brand_collection.url }}" class="brand-logo" aria-label="{{ brand_collection.title | escape }} entdecken" {{ block.shopify_attributes }}>
              {%- if brand_image != blank -%}
                {{ brand_image | image_url: width: 320 | image_tag: loading: 'lazy', alt: brand_collection.title }}
              {%- else -%}
                <span class="brand-name">{{ brand_collection.title | escape }}</span>
              {%- endif -%}
            </a>
          {%- elsif request.design_mode -%}
            <div {{ block.shopify_attributes }}>
              <p>Marken-Kollektion verknüpfen</p>
              <p>Wählen Sie eine vorhandene Kollektion. Titel, Bild und Ziel kommen direkt aus Shopify.</p>
            </div>
          {%- endif -%}
        {%- else -%}
          {%- if request.design_mode -%}
            <p>Fügen Sie einen Marken-Block hinzu und wählen Sie die zugehörige Kollektion.</p>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Marken-Kollektionen",
  "settings": [
    {
      "type": "paragraph",
      "content": "Verknüpfen Sie jede Marke mit ihrer Shopify-Kollektion. Der Titel und das Ziel kommen aus der Kollektion. Optional: Logo als Datei-Metafeld upswing.brand_logo (Bild) pflegen. Sonst erscheint das Kollektionsbild oder der Titel. Nicht verknüpfte Blöcke erscheinen nur im Theme-Editor."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Dachzeile",
      "default": "UNSERE MARKEN"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marken-Kollektion",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Marken-Kollektionen"
    }
  ]
}
{% endschema %}

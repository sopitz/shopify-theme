{%- assign header_business_url = section.settings.b2b_url | default: '/pages/b2b' -%}
{%- assign header_guide_url = section.settings.guide_url | default: '/pages/themen' -%}
{%- assign header_about_url = section.settings.about_url | default: '/pages/upswing-werte' -%}
{%- capture header_advice_url -%}{%- render 'filial-anchor-url', url: section.settings.advice_url, fallback_url: '/pages/contact' -%}{%- endcapture -%}
{%- assign header_advice_url = header_advice_url | strip -%}
<header class="site-header" data-navigation-root>
  <div class="header-utility" data-header-utility>
  {% if section.settings.show_reviews %}
    <div class="header-review-bar"><div class="container header-review-inner"><p>Persönlich beraten. Von Kundinnen und Kunden empfohlen.</p>{% render 'customer-review-badge', placement: 'header' %}</div></div>
  {% endif %}
  {% if section.settings.announcement != blank %}
    <div class="announcement-bar"><div class="container announcement-inner"><span>{{ section.settings.announcement | escape }}</span><a href="{{ header_advice_url | escape }}">Persönliche Beratung {% render 'icon', name: 'arrow' %}</a></div></div>
  {% endif %}
  </div>
  <div class="header-core" data-header-core>
  <div class="container header-main">
    <button class="icon-button menu-toggle" type="button" data-navigation-mobile-toggle aria-controls="MobileNavigation" aria-expanded="false" aria-label="Menü öffnen">{% render 'icon', name: 'menu' %}</button>
    <a href="{{ routes.root_url }}" class="site-logo" style="--logo-width: {{ settings.logo_width }}px" aria-label="{{ shop.name | escape }} – Startseite">
      {% if settings.logo != blank %}{{ settings.logo | image_url: width: 420 | image_tag: width: settings.logo_width, loading: 'eager', alt: shop.name }}{% else %}<img src="{{ 'upswing-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" height="58" loading="eager">{% endif %}
    </a>
    {% render 'predictive-search-form', id: 'HeaderSearch', class: 'header-search', placeholder: 'Was tut dir gut?', section: section %}
    <div class="header-actions">
      <a class="icon-button header-mobile-search" href="{{ routes.search_url }}" aria-label="Suche öffnen">{% render 'icon', name: 'search' %}</a>
      <a class="header-advice" href="{{ header_advice_url | escape }}">{% render 'icon', name: 'phone' %}<span>Wir beraten dich gerne</span></a>
      <div class="header-account-cart">
        {% if shop.customer_accounts_enabled %}<a class="icon-button" href="{{ routes.account_url }}" aria-label="Mein Kundenkonto">{% render 'icon', name: 'user' %}</a>{% endif %}
        <a class="icon-button cart-link" href="{{ routes.cart_url }}" aria-label="Warenkorb mit {{ cart.item_count }} Artikeln">{% render 'icon', name: 'bag' %}<span class="cart-count" data-cart-count>{{ cart.item_count }}</span></a>
      </div>
    </div>
  </div>
  {% liquid
    assign menu_has_guide = false
    assign menu_has_about = false
    assign menu_has_business = false
    for navigation_link in section.settings.menu.links
      if navigation_link.url == header_guide_url
        assign menu_has_guide = true
      endif
      assign navigation_label_key = navigation_link.title | handleize
      if navigation_link.url == header_about_url or navigation_label_key == 'uber-uns' or navigation_label_key == 'ueber-uns'
        assign menu_has_about = true
      endif
      if navigation_link.url == header_business_url
        assign menu_has_business = true
      endif
    endfor
  %}
  <div class="nav-wrap">
    <div class="container main-nav mega-nav">
      <nav class="desktop-navigation" aria-label="Hauptnavigation">
        <ul class="mega-menu-list">
          {% render 'header-menu-items', mode: 'desktop', links: section.settings.menu.links, header_section: section %}
          {% if section.settings.menu.links == blank and request.design_mode %}<li class="mega-menu-item"><span class="mega-menu-link">Wähle im Theme-Editor ein Hauptmenü aus.</span></li>{% endif %}
          {% if header_guide_url != blank and menu_has_guide == false %}<li class="mega-menu-item mega-menu-utility"><a class="mega-menu-link" href="{{ header_guide_url }}">{{ section.settings.guide_label | escape }}</a></li>{% endif %}
          {% if menu_has_about == false %}{% render 'header-about-menu', mode: 'desktop', header_section: section %}{% endif %}
        </ul>
      </nav>
      {% if header_business_url != blank and menu_has_business == false %}<a class="nav-business" href="{{ header_business_url }}">{% render 'icon', name: 'office' %} Für Unternehmen</a>{% endif %}
    </div>
  </div>
  <nav id="MobileNavigation" class="mobile-nav container" aria-label="Mobile Hauptnavigation" data-navigation-mobile-panel hidden>
    {% render 'predictive-search-form', id: 'MobileSearch', class: 'mobile-search', placeholder: 'Produkte und Marken suchen', section: section %}
    <ul class="mobile-nav-list">
      {% render 'header-menu-items', mode: 'mobile', links: section.settings.menu.links, header_section: section %}
      {% if section.settings.menu.links == blank and request.design_mode %}<li><span class="mobile-nav-link">Wähle im Theme-Editor ein Hauptmenü aus.</span></li>{% endif %}
      {% if header_guide_url != blank and menu_has_guide == false %}<li><a class="mobile-nav-link" href="{{ header_guide_url }}">{{ section.settings.guide_label | escape }}</a></li>{% endif %}
      {% if menu_has_about == false %}{% render 'header-about-menu', mode: 'mobile', header_section: section %}{% endif %}
      {% if header_business_url != blank and menu_has_business == false %}<li><a class="mobile-nav-link" href="{{ header_business_url }}">Für Unternehmen</a></li>{% endif %}
    </ul>
  </nav>
  </div>
</header>
<script src="{{ 'navigation.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'sticky-header.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Kopfbereich",
  "class": "shopify-section-header",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Google-Bewertungen im Header anzeigen",
      "default": true,
      "info": "Widget und Google-Link unter Theme-Einstellungen → Google-Bewertungen pflegen."
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Servicetext"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Hauptmenü",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "advice_url",
      "label": "Beratungsseite"
    },
    {
      "type": "url",
      "id": "b2b_url",
      "label": "Seite für Unternehmen"
    },
    {
      "type": "text",
      "id": "guide_label",
      "label": "Wissenslink · Bezeichnung",
      "default": "Wissen & Ratgeber"
    },
    {
      "type": "url",
      "id": "guide_url",
      "label": "Wissenslink · Ziel"
    },
    {
      "type": "text",
      "id": "about_label",
      "label": "Über uns · Bezeichnung",
      "default": "Über uns"
    },
    {
      "type": "url",
      "id": "about_url",
      "label": "Über uns · Übersichtsseite"
    },
    {
      "type": "link_list",
      "id": "about_menu",
      "label": "Über uns · Untermenü",
      "info": "Ein eigenes Menü hat Vorrang. Ohne Auswahl nutzen wir Über-uns-Unterlinks aus dem Hauptmenü oder die vollständigen Originalseiten."
    }
  ],
  "blocks": [
    {
      "type": "menu_image",
      "name": "Navigation · Bild",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Bezeichnung",
          "default": "Navigationsbild"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Ziel des Menülinks"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        }
      ]
    }
  ],
  "max_blocks": 50
}
{% endschema %}

{%- capture footer_advice_url -%}{%- render 'filial-anchor-url', url: section.settings.advice_url, fallback_url: '/pages/contact' -%}{%- endcapture -%}
{%- assign footer_advice_url = footer_advice_url | strip -%}
{% if section.settings.show_reviews %}
  {% render 'customer-reviews', section: section %}
{% endif %}
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand"><a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} – Startseite"><img src="{{ 'upswing-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="160" height="44" loading="lazy"></a><p>{{ section.settings.description | escape }}</p><a class="text-link" href="{{ footer_advice_url | escape }}">Wir sind für dich da {% render 'icon', name: 'arrow' %}</a></div>
    {% for block in section.blocks %}<div class="footer-column" {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2>{% if block.settings.menu.links != blank %}<ul>{% for link in block.settings.menu.links %}{%- capture footer_link_url -%}{%- render 'filial-anchor-url', url: link.url, fallback_url: '/pages/filialubersicht' -%}{%- endcapture -%}
{%- assign footer_link_url = footer_link_url | strip -%}
<li><a href="{{ footer_link_url | escape }}">{{ link.title | escape }}</a></li>{% endfor %}</ul>{% else %}{% case block.type %}{% when 'shopping' %}<ul><li><a href="{{ routes.all_products_collection_url }}">Alle Produkte</a></li></ul>{% if request.design_mode %}<p>Wähle im Theme-Editor ein Menü für das Sortiment aus.</p>{% endif %}{% when 'service' %}<ul><li><a href="/pages/themen">Produktberatung</a></li><li><a href="/pages/filialubersicht#Filialen">Unsere Filialen</a></li><li><a href="/pages/contact">Kontakt</a></li><li><a href="/pages/b2b">Für Unternehmen</a></li></ul>{% when 'contact' %}<p>Persönlich vor Ort.<br>In 5 Schweizer Filialen.</p><a href="/pages/filialubersicht#Filialen" class="text-link">Filiale finden</a>{% if settings.contact_phone != blank %}<p><a href="tel:{{ settings.contact_phone | replace: ' ', '' }}">{{ settings.contact_phone | escape }}</a></p>{% endif %}{% if settings.contact_email != blank %}<p><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email | escape }}</a></p>{% endif %}{% endcase %}{% endif %}</div>{% endfor %}
  </div>
  <div class="container footer-bottom"><p>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p><nav aria-label="Rechtliche Informationen">{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}</nav>{% if section.settings.show_payment_icons %}<ul class="payment-icons" aria-label="Akzeptierte Zahlungsarten">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>{% endfor %}</ul>{% endif %}</div>
</footer>
{% schema %}
{
  "name": "Fussbereich",
  "settings": [
    {
      "type": "header",
      "content": "Google-Bewertungen"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Bewertungen oberhalb des Fussbereichs anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Fussbereich"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Beschreibung",
      "default": "Hochwertige Produkte. Persönliche Beratung. Für mehr Leichtigkeit in deinem Alltag."
    },
    {
      "type": "url",
      "id": "advice_url",
      "label": "Kontaktseite"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Aktive Zahlungsarten anzeigen",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "shopping",
      "name": "Sortiment",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Entdecken"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü"
        }
      ]
    },
    {
      "type": "service",
      "name": "Service",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Wir helfen weiter"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Kontakt",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Persönlich für dich"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü"
        }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}

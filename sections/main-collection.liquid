{%- liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign consultation_url = section.settings.consultation_url | default: '/pages/filialubersicht'
  assign model_filters = section.settings.model_filter_parameters | remove: ' ' | split: ','
  assign visible_filter_count = 0
-%}
{%- capture consultation_url -%}{%- render 'filial-anchor-url', url: consultation_url, fallback_url: '/pages/filialubersicht' -%}{%- endcapture -%}
{%- assign consultation_url = consultation_url | strip -%}
{%- capture collection_display_title -%}{%- render 'collection-display-title', collection: collection -%}{%- endcapture -%}
{%- assign collection_display_title = collection_display_title | strip -%}
{%- assign intro_text = section.settings.intro_text | strip_html | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&#xA0;', ' ' | replace: '&#xa0;', ' ' | replace: ' ', ' ' | strip -%}
{%- assign native_description = collection.description -%}
{%- assign has_native_faq = false -%}
{%- if native_description contains '<h2>Häufige Fragen</h2>' -%}
  {%- capture native_faq_heading -%}<h2 id="CollectionNativeFaq-{{ section.id }}">Häufige Fragen</h2>{%- endcapture -%}
  {%- assign native_description = native_description | replace_first: '<h2>Häufige Fragen</h2>', native_faq_heading -%}
  {%- assign has_native_faq = true -%}
{%- endif -%}
{%- assign description_text = collection.description | strip_html | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&#xA0;', ' ' | replace: '&#xa0;', ' ' | replace: ' ', ' ' | strip_newlines | strip | downcase -%}
{%- capture aico_guide_present -%}{% render 'collection-aico-items', field: collection.metafields.custom_fields.good_to_know, mode: 'guide', output: 'has_content' %}{%- endcapture -%}
{%- capture aico_faq_present -%}{% render 'collection-aico-items', field: collection.metafields.custom_fields.faq, mode: 'faq', output: 'has_content' %}{%- endcapture -%}
{%- assign aico_guide_present = aico_guide_present | strip -%}
{%- assign aico_faq_present = aico_faq_present | strip -%}
{%- assign editor_content_allowed = false -%}
{%- if section.settings.content_source == 'editor' or description_text == blank -%}{%- assign editor_content_allowed = true -%}{%- endif -%}
{%- capture guide_cards -%}
  {%- if section.settings.content_source != 'editor' and aico_guide_present == 'true' -%}
    {% render 'collection-aico-items', field: collection.metafields.custom_fields.good_to_know, mode: 'guide', description: collection.description %}
  {%- elsif editor_content_allowed -%}
    {%- for block in section.blocks -%}
      {%- assign guide_text = block.settings.body | strip_html | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&#xA0;', ' ' | replace: '&#xa0;', ' ' | replace: ' ', ' ' | strip -%}
      {%- assign normalized_guide_text = guide_text | strip_newlines | downcase -%}
      {%- if block.type == 'guide' and block.settings.heading != blank and guide_text != blank -%}
        {%- unless description_text contains normalized_guide_text -%}<article class="collection-guide-card" {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><div class="rte">{{ block.settings.body }}</div></article>{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign guide_cards = guide_cards | strip -%}
{%- capture faq_items -%}
  {%- if section.settings.content_source != 'editor' and aico_faq_present == 'true' -%}
    {% render 'collection-aico-items', field: collection.metafields.custom_fields.faq, mode: 'faq', description: collection.description %}
  {%- elsif editor_content_allowed -%}
    {%- for block in section.blocks -%}
      {%- assign answer_text = block.settings.answer | strip_html | replace: '&nbsp;', ' ' | replace: '&#160;', ' ' | replace: '&#xA0;', ' ' | replace: '&#xa0;', ' ' | replace: ' ', ' ' | strip -%}
      {%- assign normalized_question = block.settings.question | strip_html | replace: ' ', ' ' | strip_newlines | strip | downcase -%}
      {%- if block.type == 'faq' and normalized_question != blank and answer_text != blank -%}
        {%- unless description_text contains normalized_question -%}<details class="collection-faq-item" {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}{% render 'icon', name: 'chevron' %}</summary><div class="rte">{{ block.settings.answer }}{% if block.settings.related_collection.url != blank and block.settings.link_label != blank %}<p><a class="text-link" href="{{ block.settings.related_collection.url }}">{{ block.settings.link_label | escape }}</a></p>{% endif %}</div></details>{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign faq_items = faq_items | strip -%}
{%- capture shortcut_links -%}
  {%- if section.settings.show_quick_links -%}
    <a class="category-chip" href="#CollectionProducts-{{ section.id }}">{{ section.settings.products_link_label | default: 'Produkte ansehen' | escape }}{% render 'icon', name: 'arrow' %}</a>
    {%- if guide_cards != blank -%}<a class="category-chip" href="#CollectionGuide-{{ section.id }}">{{ section.settings.guide_link_label | default: 'Auswahlhilfe' | escape }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    {%- if description_text != blank -%}<a class="category-chip" href="#CollectionDescription-{{ section.id }}">Wissenswertes{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
    {%- if has_native_faq -%}<a class="category-chip" href="#CollectionNativeFaq-{{ section.id }}">Fragen &amp; Antworten{% render 'icon', name: 'arrow' %}</a>{%- elsif faq_items != blank -%}<a class="category-chip" href="#CollectionFaq-{{ section.id }}">Fragen &amp; Antworten{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
  {%- endif -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'shortcut' and block.settings.url != blank and block.settings.label != blank -%}<a class="category-chip" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign shortcut_links = shortcut_links | strip -%}
{%- liquid
  assign is_guided_collection = false
  if intro_text != blank or guide_cards != blank or faq_items != blank or description_text != blank
    assign is_guided_collection = true
  endif
-%}
<section class="collection-section section-space{% if is_guided_collection %} collection-section--guided{% endif %}" id="Collection-{{ section.id }}">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Brotkrumennavigation"><a href="{{ routes.root_url }}">Startseite</a><span aria-hidden="true">/</span><span>{{ collection_display_title | escape }}</span></nav>
    <header class="collection-header">
      <div><p class="eyebrow">Mit Beratung zur passenden Wahl</p><h1>{{ collection_display_title | escape }}</h1>{% if intro_text != blank %}<div class="rte collection-intro">{{ section.settings.intro_text }}</div>{% endif %}</div>
      <a class="button secondary" href="{{ consultation_url }}">Bei der Auswahl helfen lassen {% render 'icon', name: 'arrow' %}</a>
    </header>
    {%- if shortcut_links != blank -%}
      <nav class="collection-shortcuts" aria-label="Schnell zur passenden Auswahl">{{ shortcut_links }}</nav>
    {%- endif -%}
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- capture collection_filter_form -%}
        <form class="filters-sidebar" action="{{ collection.url }}" method="get" id="CollectionFilters-{{ section.id }}">
          <div class="filter-heading"><h2>Deine Auswahl</h2><a class="text-link" href="{{ collection.url }}?sort_by={{ current_sort | url_encode }}">Zurücksetzen</a></div>
          {%- for filter in collection.filters -%}
            {%- liquid
              assign show_filter = true
              if filter.param_name == 'filter.p.m.upswing.model_primary'
                assign show_filter = false
              elsif section.settings.model_collection
                unless model_filters contains filter.param_name
                  assign show_filter = false
                endunless
              endif
              if show_filter
                assign visible_filter_count = visible_filter_count | plus: 1
              endif
            -%}
            {%- if show_filter -%}
              <details class="filter-group"{% if filter.active_values.size > 0 or visible_filter_count <= 3 or filter.min_value.value != blank or filter.max_value.value != blank %} open{% endif %}>
                <summary>{{ filter.label | escape }} {% render 'icon', name: 'chevron' %}</summary>
                <div class="filter-options">
                  {%- case filter.type -%}
                    {%- when 'boolean', 'list' -%}
                      {%- for value in filter.values -%}
                        {%- capture filter_input_id -%}Filter-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}{%- endcapture -%}
                        {% render 'collection-filter-option', value: value, input_id: filter_input_id %}
                      {%- endfor -%}
                    {%- when 'price_range' -%}
                      <div class="price-range">
                        <label for="PriceMin-{{ section.id }}">Von ({{ cart.currency.iso_code }})<input type="number" name="{{ filter.min_value.param_name }}" id="PriceMin-{{ section.id }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" step="0.01"{% if filter.min_value.value != blank %} value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %} placeholder="0" inputmode="decimal"></label>
                        <label for="PriceMax-{{ section.id }}">Bis ({{ cart.currency.iso_code }})<input type="number" name="{{ filter.max_value.param_name }}" id="PriceMax-{{ section.id }}" min="0" max="{{ filter.range_max | divided_by: 100.0 }}" step="0.01"{% if filter.max_value.value != blank %} value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %} placeholder="{{ filter.range_max | divided_by: 100.0 }}" inputmode="decimal"></label>
                      </div>
                  {%- endcase -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
          {%- if visible_filter_count == 0 -%}<p class="filter-help">Entdecke die Produkte oder lass dich persönlich beraten.</p>{%- endif -%}
          <button class="button filter-apply" type="submit">Auswahl anwenden</button>
          <div class="filter-consultation"><p class="eyebrow">Noch unsicher?</p><strong>Wir nehmen uns Zeit.</strong><p>Finde gemeinsam mit uns das Produkt, das zu deinem Alltag passt.</p><a class="text-link" href="{{ consultation_url }}">Persönliche Beratung</a></div>
        </form>
      {%- endcapture -%}
      <div class="collection-layout{% if is_guided_collection and visible_filter_count == 0 %} collection-layout--no-filters{% endif %}">
        {% if is_guided_collection %}
          <details class="collection-filter-disclosure" data-collection-filters{% if visible_filter_count == 0 %} hidden{% endif %}><summary>Filter{% render 'icon', name: 'chevron' %}</summary>{{ collection_filter_form }}</details>
        {% else %}
          {{ collection_filter_form }}
        {% endif %}
        <div class="collection-results" id="CollectionProducts-{{ section.id }}">
          <div class="collection-toolbar">
            <p class="result-count" role="status">{{ collection.products_count }} {% if section.settings.model_collection %}{% if collection.products_count == 1 %}Modell{% else %}Modelle{% endif %}{% else %}{% if collection.products_count == 1 %}Produkt{% else %}Produkte{% endif %}{% endif %}</p>
            <div class="sort-control"><label for="CollectionSort-{{ section.id }}">Sortieren</label><select id="CollectionSort-{{ section.id }}" name="sort_by" form="CollectionFilters-{{ section.id }}" data-sort-select data-sort-page-param="{{ paginate.page_param }}">{%- for option in collection.sort_options -%}<option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>{%- endfor -%}</select><button class="text-link sort-apply" type="submit" form="CollectionFilters-{{ section.id }}" data-sort-apply>Anwenden</button></div>
          </div>
          {%- if section.settings.model_collection -%}<p class="collection-model-note">Ein Modell, alle Farben. Wähle deine Farbe direkt beim Produkt.</p>{%- endif -%}
          <div class="active-filters" aria-label="Aktive Filter">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}<a class="active-filter" href="{{ value.url_to_remove }}">{{ filter.label | escape }}: {{ value.label | escape }} {% render 'icon', name: 'close' %}<span class="visually-hidden">Filter entfernen</span></a>{%- endfor -%}
              {%- if filter.type == 'price_range' -%}{%- if filter.min_value.value != blank or filter.max_value.value != blank -%}<a class="active-filter" href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money_with_currency }} – {{ filter.max_value.value | default: filter.range_max | money_with_currency }} {% render 'icon', name: 'close' %}<span class="visually-hidden">Preisfilter entfernen</span></a>{%- endif -%}{%- endif -%}
            {%- endfor -%}
          </div>
          {%- if collection.products_count > 0 -%}
            <div class="product-grid collection-product-grid">
              {%- for product in collection.products -%}{% render 'product-card', product: product, card_facts: section.settings.show_product_facts, card_fact_1_key: section.settings.card_fact_1_key, card_fact_1_label: section.settings.card_fact_1_label, card_fact_2_key: section.settings.card_fact_2_key, card_fact_2_label: section.settings.card_fact_2_label %}{%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Weitere Produkte">{{ paginate | default_pagination: next: 'Weiter', previous: 'Zurück' }}</nav>{%- endif -%}
          {%- else -%}
            <div class="empty-state"><h2>Keine Produkte für diese Auswahl.</h2><p>Entferne einen Filter oder sprich mit uns über deine Wünsche.</p><div class="button-row"><a class="button" href="{{ collection.url }}">Alle Produkte dieser Auswahl</a><a class="button secondary" href="{{ consultation_url }}">Beratung finden</a></div></div>
          {%- endif -%}
        </div>
      </div>
    {%- endpaginate -%}
    {% if collection.description != blank %}
      <section class="collection-description-block" id="CollectionDescription-{{ section.id }}" aria-labelledby="CollectionDescriptionTitle-{{ section.id }}">
        <h2 class="collection-information-title" id="CollectionDescriptionTitle-{{ section.id }}">Wissenswertes zu {{ collection_display_title | escape }}</h2>
        <div class="rte collection-description">{{ native_description }}</div>
      </section>
    {% endif %}
    {% if guide_cards != blank %}
      <section class="collection-buying-guide" id="CollectionGuide-{{ section.id }}" aria-labelledby="CollectionGuideTitle-{{ section.id }}">
        <div class="collection-guidance-heading"><h2 id="CollectionGuideTitle-{{ section.id }}">{% if section.settings.content_source != 'editor' and aico_guide_present == 'true' %}{{ section.settings.aico_guide_heading | default: 'Gut zu wissen' | escape }}{% else %}{{ section.settings.guide_heading | default: 'Hilfe bei der Auswahl' | escape }}{% endif %}</h2><a class="text-link" href="{{ consultation_url }}">Persönlich beraten lassen {% render 'icon', name: 'arrow' %}</a></div>
        <div class="collection-guide-grid">{{ guide_cards }}</div>
      </section>
    {% endif %}
    {% if faq_items != blank %}
      <section class="collection-faq" id="CollectionFaq-{{ section.id }}" aria-labelledby="CollectionFaqTitle-{{ section.id }}">
        <h2 id="CollectionFaqTitle-{{ section.id }}">{% if description_text != blank and section.settings.content_source != 'editor' %}Weitere Fragen &amp; Antworten{% else %}{{ section.settings.faq_heading | default: 'Häufige Fragen' | escape }}{% endif %}</h2>
        <div class="collection-faq-list">{{ faq_items }}</div>
      </section>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Kollektion & Filter",
  "settings": [
    {"type": "select", "id": "content_source", "label": "Quelle für Kaufhilfe und FAQ", "default": "aico", "options": [{"value": "aico", "label": "AICO-Inhalte bevorzugen"}, {"value": "editor", "label": "Theme-Blöcke verwenden"}], "info": "Liest custom_fields.good_to_know und custom_fields.faq (JSON). Der Kategorietext erscheint einmal. Ohne AICO-Inhalte und Kategorietext dienen Theme-Blöcke als Ersatz."},
    {"type": "text", "id": "aico_guide_heading", "label": "Überschrift der AICO-Kaufhilfe", "default": "Gut zu wissen"},
    {"type": "richtext", "id": "intro_text", "label": "Kurze Orientierung oberhalb der Produkte"},
    {"type": "checkbox", "id": "show_quick_links", "label": "Sprunglinks zu Produkten und Kaufhilfe anzeigen", "default": true},
    {"type": "text", "id": "products_link_label", "label": "Sprunglink zu den Produkten", "default": "Produkte ansehen"},
    {"type": "text", "id": "guide_link_label", "label": "Sprunglink zur Kaufhilfe", "default": "Auswahlhilfe"},
    {"type": "text", "id": "guide_heading", "label": "Überschrift der Kaufhilfe", "default": "Hilfe bei der Auswahl"},
    {"type": "text", "id": "faq_heading", "label": "Überschrift der Fragen", "default": "Häufige Fragen"},
    {"type": "checkbox", "id": "show_product_facts", "label": "Geprüfte Merkmale auf Produktkarten anzeigen", "default": true},
    {"type": "text", "id": "card_fact_1_key", "label": "Metafeld für Merkmal 1", "default": "aico_metafields.obermaterial_list", "info": "Vorhandenes Produktmetafeld als namespace.key. Fehlende Werte bleiben verborgen."},
    {"type": "text", "id": "card_fact_1_label", "label": "Bezeichnung für Merkmal 1", "default": "Obermaterial"},
    {"type": "text", "id": "card_fact_2_key", "label": "Metafeld für Merkmal 2", "default": "aico_metafields.schuhart_list", "info": "Vorhandenes Produktmetafeld als namespace.key. Keine Ableitung aus Produktnamen."},
    {"type": "text", "id": "card_fact_2_label", "label": "Bezeichnung für Merkmal 2", "default": "Schuhart"},
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Produkte pro Seite",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "url",
      "id": "consultation_url",
      "label": "Beratung / Filialen"
    },
    {
      "type": "checkbox",
      "id": "model_collection",
      "label": "Diese Kollektion enthält ein Primärprodukt je Modell",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Modellgruppierung: Erst eine kuratierte Kollektion mit einem Primärprodukt pro Modell anlegen und upswing.model_products für übrige Farben pflegen. Kein Produkt wird nach Pagination ausgeblendet. In Modellkollektionen werden nur unten freigegebene Modellfilter angezeigt; normale Farb-, Grössen-, Preis- und Lagerfilter prüfen nur das Primärprodukt."
    },
    {
      "type": "text",
      "id": "model_filter_parameters",
      "label": "Erlaubte Filter in Modellkollektionen",
      "default": "filter.p.vendor,filter.p.product_type,filter.p.m.upswing.model_colors",
      "info": "Kommagetrennte Shopify Filterparameter. Weitere Metafeldfilter erst ergänzen, wenn Primärprodukte geprüfte Attribute des gesamten Modells enthalten. Search & Discovery muss diese Filter bereitstellen."
    }
  ],
  "blocks": [
    {"type": "guide", "name": "Kaufhilfe", "settings": [{"type": "text", "id": "heading", "label": "Titel"}, {"type": "richtext", "id": "body", "label": "Erklärung"}]},
    {"type": "faq", "name": "Frage und Antwort", "settings": [{"type": "text", "id": "question", "label": "Frage"}, {"type": "richtext", "id": "answer", "label": "Antwort"}, {"type": "collection", "id": "related_collection", "label": "Passende Kollektion (optional)"}, {"type": "text", "id": "link_label", "label": "Linktext zur Kollektion"}]},
    {
      "type": "shortcut",
      "name": "Schnelleinstieg",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Zielkollektion / Seite"
        }
      ]
    }
  ]
}
{% endschema %}

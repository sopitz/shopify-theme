<article class="section-space article-section"><div class="container article-width"><a class="text-link" href="{{ blog.url }}">{% render 'icon', name: 'arrow' %} Zurück zu {{ blog.title | escape }}</a><p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}{% if section.settings.show_author %} · {{ article.author | escape }}{% endif %}</p><h1>{{ article.title | escape }}</h1>{% if article.image %}{{ article.image | image_url: width: 1500 | image_tag: loading: 'eager', class: 'article-hero' }}{% endif %}<div class="rte">{{ article.content }}</div><div class="guide-advice"><h2>Wir beraten dich gerne.</h2><p>Finde mit uns die Produkte, die zu deinem Alltag passen.</p><a href="/pages/contact" class="button">Kontakt aufnehmen {% render 'icon', name: 'arrow' %}</a></div></div></article>
{% schema %}
{
  "name": "Ratgeberbeitrag",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Autor anzeigen",
      "default": false
    }
  ]
}
{% endschema %}

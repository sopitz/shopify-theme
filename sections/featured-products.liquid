<section class="section-space featured-products" aria-labelledby="FeaturedTitle-{{ section.id }}"><div class="container"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="FeaturedTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.description | escape }}</p></div><a class="text-link" href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a></div><div class="product-grid">{% if section.blocks.size > 0 %}{% for block in section.blocks %}{% if block.settings.product != blank %}<div {{ block.shopify_attributes }}>{% render 'product-card', product: block.settings.product %}</div>{% elsif request.design_mode %}<div class="product-card" {{ block.shopify_attributes }}>{{ 'product-1' | placeholder_svg_tag: 'product-media' }}<h3>Produkt auswählen</h3><p>Wählen Sie ein Modell im Theme-Editor.</p></div>{% endif %}{% endfor %}{% elsif section.settings.collection != blank %}{% for product in section.settings.collection.products limit: section.settings.product_count %}{% render 'product-card', product: product %}{% endfor %}{% elsif request.design_mode %}{% for i in (1..4) %}<div class="product-card">{{ 'product-1' | placeholder_svg_tag: 'product-media' }}<h3>Produkt auswählen</h3></div>{% endfor %}{% endif %}</div></div></section>
{% schema %}
{
  "name": "Ausgewählte Modelle",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "UNSERE EMPFEHLUNGEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Gute Begleiter für jeden Tag."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Einführung",
      "default": "Entdecken Sie ausgewählte Modelle – mit allen verfügbaren Farben an einem Ort."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Linktext",
      "default": "Sortiment entdecken"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion als Alternative zu Einzelprodukten"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Anzahl aus Kollektion",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Ausgewähltes Modell",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produkt (primäres Modell)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ausgewählte Modelle"
    }
  ]
}
{% endschema %}

{%- liquid
  assign featured_collection = section.settings.collection
  assign featured_product_count = 0
  if section.blocks.size > 0
    for block in section.blocks
      assign featured_product = block.settings.product
      if featured_product != blank and featured_product.id != blank and featured_product.url != blank
        assign featured_product_count = featured_product_count | plus: 1
      endif
    endfor
  elsif featured_collection != blank and featured_collection.id != blank and featured_collection.url != blank
    for product in featured_collection.products limit: section.settings.product_count
      if product != blank and product.id != blank and product.url != blank
        assign featured_product_count = featured_product_count | plus: 1
      endif
    endfor
  endif
-%}
{%- if featured_product_count > 0 or request.design_mode -%}
  <section class="section-space featured-products" aria-labelledby="FeaturedTitle-{{ section.id }}">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 id="FeaturedTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.description != blank -%}<p>{{ section.settings.description | escape }}</p>{%- endif -%}
        </div>
        {%- if featured_product_count > 0 and featured_collection != blank and featured_collection.id != blank and featured_collection.url != blank and featured_collection.products_count > 0 and section.settings.link_label != blank -%}
          <a class="text-link" href="{{ featured_collection.url }}">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
      <div class="product-grid">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- assign featured_product = block.settings.product -%}
            {%- if featured_product != blank and featured_product.id != blank and featured_product.url != blank -%}
              <div {{ block.shopify_attributes }}>{% render 'product-card', product: featured_product %}</div>
            {%- elsif request.design_mode -%}
              <div class="product-card" {{ block.shopify_attributes }}>
                <h3>Produkt verknüpfen</h3>
                <p>Wählen Sie ein vorhandenes, im Onlineshop veröffentlichtes Produkt.</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif featured_product_count > 0 -%}
          {%- for product in featured_collection.products limit: section.settings.product_count -%}
            {%- if product != blank and product.id != blank and product.url != blank -%}
              {% render 'product-card', product: product %}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif request.design_mode -%}
          <div class="product-card">
            <h3>Produkte verknüpfen</h3>
            <p>Wählen Sie eine Kollektion mit veröffentlichten Produkten oder fügen Sie Produkt-Blöcke hinzu und wählen Sie die einzelnen Produkte.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Ausgewählte Modelle",
  "settings": [
    {
      "type": "paragraph",
      "content": "Wählen Sie einzelne Produkte in den Blöcken oder eine Kollektion ohne Produkt-Blöcke. Nicht verknüpfte Produkte erscheinen nur als Hinweis im Theme-Editor. Ohne Produkte bleibt der Abschnitt im Shop verborgen."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile",
      "default": "UNSERE EMPFEHLUNGEN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Gute Begleiter für jeden Tag."
    },
    {
      "type": "text",
      "id": "description",
      "label": "Einführung",
      "default": "Entdecken Sie unsere ausgewählten Produkte."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Linktext",
      "default": "Sortiment entdecken"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion (ohne Produkt-Blöcke)"
    },
    {
      "type": "range",
      "id": "product_count",
      "label": "Anzahl aus Kollektion",
      "default": 4,
      "min": 2,
      "max": 8,
      "step": 1
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Ausgewähltes Modell",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Produkt (primäres Modell)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Ausgewählte Modelle"
    }
  ]
}
{% endschema %}

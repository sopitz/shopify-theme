{%- comment -%}
  Delivery estimates use editable merchant policies and current Shopify data.
  Shopify only supplies store_availabilities for the selected / first available
  variant. Unselected sizes must be rendered through product-delivery with a
  variant URL before their delivery estimate is known.
{%- endcomment -%}
{%- liquid
  assign delivery_variant = variant | default: product.selected_or_first_available_variant
  assign delivery_known = false
  assign delivery_status = 'neutral'
  assign delivery_text = 'Lieferzeit abhängig von der gewählten Variante'
  assign in_own_stock = false
  if delivery_variant != blank
    if delivery_variant.selected or delivery_variant.id == product.selected_or_first_available_variant.id or delivery_variant.id == product.first_available_variant.id or delivery_variant.available == false
      assign delivery_known = true
    endif
    if delivery_known
      for store in delivery_variant.store_availabilities
        if store.pick_up_enabled and store.available
          assign in_own_stock = true
          break
        endif
      endfor
      assign stock_delivery = settings.delivery_stock_days | strip
      assign standard_delivery = settings.delivery_standard_days | strip
      assign extended_delivery = settings.delivery_extended_days | strip
      assign variant_delivery = delivery_variant.metafields.upswing.delivery_time.value | strip
      assign product_delivery = product.metafields.upswing.delivery_time.value | strip
      assign individual_delivery = variant_delivery | default: product_delivery
      assign delivery_status = 'normal'
      if delivery_variant.available == false
        assign delivery_text = 'Aktuell nicht lieferbar'
        assign delivery_status = 'unavailable'
      elsif in_own_stock
        if stock_delivery != blank
          assign delivery_text = stock_delivery | prepend: 'Sofort verfügbar · Lieferzeit: '
        else
          assign delivery_text = 'Sofort verfügbar · Lieferzeit auf Anfrage'
        endif
        assign delivery_status = 'fast'
      elsif delivery_variant.available
        assign lead_time = individual_delivery
        if lead_time == blank
          assign brand = product.vendor | downcase | strip
          assign standard_vendors = settings.delivery_standard_vendors | split: ','
          assign extended_vendors = settings.delivery_extended_vendors | split: ','
          for vendor in standard_vendors
            assign normalized_vendor = vendor | downcase | strip
            if normalized_vendor != blank and normalized_vendor == brand
              assign lead_time = standard_delivery
              break
            endif
          endfor
          if lead_time == blank
            for vendor in extended_vendors
              assign normalized_vendor = vendor | downcase | strip
              if normalized_vendor != blank and normalized_vendor == brand
                assign lead_time = extended_delivery
                break
              endif
            endfor
          endif
        endif
        if lead_time != blank
          assign delivery_text = lead_time | prepend: 'Online verfügbar · Lieferzeit: '
        else
          assign delivery_text = 'Online verfügbar · Lieferzeit auf Anfrage'
        endif
      else
        assign delivery_text = 'Aktuell nicht lieferbar'
        assign delivery_status = 'unavailable'
      endif
    endif
  endif
-%}
{%- if output == 'json' -%}
  {%- capture delivery_json_escape -%}\u003c{%- endcapture -%}
  {%- if delivery_known -%}{"text":{{ delivery_text | json | replace: '<', delivery_json_escape }},"status":{{ delivery_status | json }}}{%- else -%}null{%- endif -%}
{%- else -%}
  <p class="product-availability" data-product-availability data-delivery-status="{{ delivery_status }}" data-delivery-variant="{{ delivery_variant.id }}" role="status">{{ delivery_text | escape }}</p>
{%- endif -%}

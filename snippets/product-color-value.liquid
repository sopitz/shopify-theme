{%- liquid
  assign explicit_color = ''
  assign color_sources = 'aico|upswing' | split: '|'
  for source in color_sources
    if source == 'aico'
      assign candidate = color_product.metafields.aico.pd_color_hex.value
    else
      assign candidate = color_product.metafields.upswing.color_hex.value
    endif
    capture explicit_color
      render 'product-color-hex', candidate: candidate
    endcapture
    assign explicit_color = explicit_color | strip
    if explicit_color != blank
      break
    endif
  endfor
-%}
{%- if explicit_color != blank -%}
  {{- explicit_color -}}
{%- else -%}
  {%- for option in color_product.options_with_values -%}
    {%- assign option_name = option.name | downcase | strip -%}
    {%- if option_name == 'farbe' or option_name == 'color' or option_name == 'colour' -%}
      {%- for value in option.values -%}
        {%- if value.selected and value.swatch.color != blank -%}
          {{- value.swatch.color -}}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

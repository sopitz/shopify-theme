{%- liquid
  assign explicit_color = ''
  assign color_sources = 'aico|upswing' | split: '|'
  for source in color_sources
    if source == 'aico'
      assign candidate = color_product.metafields.aico.pd_color_hex.value
    else
      assign candidate = color_product.metafields.upswing.color_hex.value
    endif
    assign candidate_type = candidate | json | slice: 0
    if candidate_type != '"'
      continue
    endif
    assign candidate = candidate | strip
    assign prefix = candidate | slice: 0
    assign hex = candidate | remove_first: '#' | downcase
    assign remainder = hex | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'a' | remove: 'b' | remove: 'c' | remove: 'd' | remove: 'e' | remove: 'f'
    if prefix == '#' and remainder == blank
      if hex.size == 3 or hex.size == 4 or hex.size == 6 or hex.size == 8
        assign explicit_color = candidate
        break
      endif
    endif
  endfor
-%}
{%- if explicit_color != blank -%}
  {{- explicit_color -}}
{%- else -%}
  {%- for option in color_product.options_with_values -%}
    {%- assign option_name = option.name | downcase | strip -%}
    {%- if option_name == 'farbe' or option_name == 'color' or option_name == 'colour' -%}
      {%- for value in option.values -%}
        {%- if value.selected and value.swatch.color != blank -%}
          {{- value.swatch.color -}}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

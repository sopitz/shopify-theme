{%- comment -%}Original five upswing location cards, migrated from the 2026-11-24 public source. Page destinations remain native Shopify resources.{%- endcomment -%}
<section class="migration-section migration-locations"><div class="migration-container">
<div class="migration-section-heading"><div><h2>{{ heading | default: 'Besuche uns in deiner Nähe' | escape }}</h2><div class="migration-copy rte">{% if description_html != blank %}{{ description_html }}{% else %}<p>Erlebe eine persönliche Beratung in einer unserer Filialen.</p>{% endif %}</div></div></div><div class="migration-grid migration-card-grid">
{%- assign migration_location = pages['standort-thun'] -%}
<article class="migration-card"><figure class="migration-card-media"><img src="{{ 'standorte-thun-1.jpg' | file_img_url: '1600x' }}" alt="Hauptstandort Thun" width="1200" height="800" loading="lazy"></figure><div class="migration-copy"><h3>Hauptstandort Thun</h3><p>Aarestrasse 14<br> 3600 Thun</p>{% if migration_location.id != blank and migration_location.url != blank %}<a class="text-link" href="{{ migration_location.url | escape }}">Öffnungszeiten &amp; Details {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></article>
{%- assign migration_location = pages['standort-ruti-zh'] -%}
<article class="migration-card"><figure class="migration-card-media"><img src="{{ 'standorte-rueti-1.jpg' | file_img_url: '1600x' }}" alt="Filiale Rüti ZH" width="1200" height="800" loading="lazy"></figure><div class="migration-copy"><h3>Filiale Rüti ZH</h3><p>Ferrachstrasse 4<br> 8630 Rüti ZH</p>{% if migration_location.id != blank and migration_location.url != blank %}<a class="text-link" href="{{ migration_location.url | escape }}">Öffnungszeiten &amp; Details {% render 'icon', name: 'arrow' %}</a>{% endif %}</div></article>

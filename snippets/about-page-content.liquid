{%- liquid
  assign kind = page_kind | default: section.settings.page_kind | default: 'auto'
  assign content_source = section.settings.content_source | default: 'design'
  assign advice_url = section.settings.advice_url | default: '/pages/filialubersicht'
  assign locations_url = section.settings.locations_url | default: '/pages/filialubersicht'
-%}
{%- capture locations_url -%}{%- render 'filial-anchor-url', url: locations_url, fallback_url: '/pages/filialubersicht' -%}{%- endcapture -%}
{%- assign locations_url = locations_url | strip -%}
{%- if kind == 'auto' -%}
  {%- capture detected_kind -%}{% render 'about-page-kind', page: page %}{%- endcapture -%}
  {%- assign kind = detected_kind | strip | default: 'about' -%}
{%- endif -%}
{%- capture example -%}
  {%- if content_source == 'design' -%}{% render 'about-page-example', page: page, page_kind: kind, advice_url: advice_url, locations_url: locations_url %}{%- endif -%}
{%- endcapture -%}
{%- assign example = example | strip -%}
{%- if example != blank -%}
  {{ example }}
{%- else -%}
  <div class="about-page about-page--{{ kind | escape }}">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Brotkrumennavigation"><a href="{{ routes.root_url }}">Startseite</a><span aria-hidden="true">/</span><span>{{ page.title | escape }}</span></nav>
      <header class="editorial-hero{% unless section.settings.image %} editorial-hero-text{% endunless %}">
        <div class="editorial-hero-copy">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h1>{{ section.settings.heading | default: page.title | escape }}</h1>
          {%- if section.settings.intro != blank -%}<div class="editorial-copy">{{ section.settings.intro }}</div>{%- endif -%}
        </div>
        {%- if section.settings.image -%}
          {%- assign hero_alt = section.settings.image.alt | default: page.title -%}
          <div class="editorial-hero-media">{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '480, 720, 1000, 1600', sizes: '(min-width: 900px) 48vw, 95vw', loading: 'eager', alt: hero_alt }}</div>
        {%- endif -%}
      </header>
      {%- unless content_source == 'editor' -%}
        {%- if page.content != blank -%}
          {%- assign native_content = page.content | replace: '<h1>', '<h2>' | replace: '</h1>', '</h2>' | remove: '✅' | remove: '📝' | remove: '👥' | remove: '⭐' -%}
          <section class="editorial-section"><article class="rte editorial-copy editorial-native-content">{{ native_content }}</article></section>
        {%- endif -%}
      {%- endunless -%}
    </div>
  </div>
{%- endif -%}
{%- if section.blocks.size > 0 -%}
  <div class="about-page about-page-editor">
    <div class="container">
      {%- assign pending_cards = '' -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          {%- capture card_markup -%}
          <article class="editorial-card" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}{%- assign card_alt = block.settings.image.alt | default: block.settings.heading | default: page.title -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '360, 540, 800', sizes: '(min-width: 900px) 30vw, 90vw', alt: card_alt }}{%- endif -%}
            {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
            {%- if block.settings.content != blank -%}<div class="editorial-copy">{{ block.settings.content }}</div>{%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
          </article>
          {%- endcapture -%}
          {%- assign pending_cards = pending_cards | append: card_markup -%}
        {%- else -%}
          {%- if pending_cards != blank -%}<section class="editorial-section"><div class="editorial-grid">{{ pending_cards }}</div></section>{%- assign pending_cards = '' -%}{%- endif -%}
          {%- case block.type -%}
            {%- when 'text' -%}
              <section class="editorial-section" {{ block.shopify_attributes }}>{% if block.settings.heading != blank %}<div class="editorial-heading"><h2>{{ block.settings.heading | escape }}</h2></div>{% endif %}{% if block.settings.content != blank %}<div class="editorial-copy rte">{{ block.settings.content }}</div>{% endif %}</section>
            {%- when 'image' -%}
              {%- if block.settings.image -%}
                {%- assign image_alt = block.settings.image.alt | default: block.settings.caption | default: page.title -%}
                <section class="editorial-section" {{ block.shopify_attributes }}><figure class="editorial-image">{{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '480, 900, 1400, 1800', sizes: '(min-width: 1400px) 1300px, 95vw', alt: image_alt }}{% if block.settings.caption != blank %}<figcaption class="editorial-copy">{{ block.settings.caption | escape }}</figcaption>{% endif %}</figure></section>
              {%- endif -%}
            {%- when 'next_step' -%}
              <section class="about-next-step" {{ block.shopify_attributes }}><div>{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.content != blank %}<div class="editorial-copy">{{ block.settings.content }}</div>{% endif %}</div>{% if block.settings.link != blank and block.settings.link_label != blank %}<a class="button" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} {% render 'icon', name: 'arrow' %}</a>{% endif %}</section>
            {%- when '@app' -%}{% render block %}
          {%- endcase -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if pending_cards != blank -%}<section class="editorial-section"><div class="editorial-grid">{{ pending_cards }}</div></section>{%- endif -%}
    </div>
  </div>
{%- endif -%}

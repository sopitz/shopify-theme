{%- comment -%}
  Responsive variants of an existing theme asset. Width-only CDN requests keep
  the original photograph and let Shopify select its supported delivery format.
  HTML dimensions and CSS keep the existing presentation and reserved space.
{%- endcomment -%}
{%- assign asset_default_size = default_width | append: 'x' -%}
{%- assign asset_widths = widths | split: ',' -%}
<img src="{{ filename | asset_img_url: asset_default_size }}" srcset="{%- for asset_width in asset_widths -%}{%- assign asset_render_width = asset_width | strip -%}{%- assign asset_size = asset_render_width | append: 'x' -%}{{ filename | asset_img_url: asset_size }} {{ asset_render_width }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}" sizes="{{ sizes | escape }}" width="{{ width }}" height="{{ height }}" alt="{{ alt | escape }}" loading="{{ loading | default: 'lazy' }}"{% if fetchpriority != blank %} fetchpriority="{{ fetchpriority | escape }}"{% endif %}>

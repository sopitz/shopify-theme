{%- assign additional_payment_methods = additional_methods | default: '' | split: ',' -%}
{%- capture payment_items -%}
  {%- assign seen_payment_methods = '|' -%}
  {%- for type in shop.enabled_payment_types -%}
    {%- assign payment_key = type | downcase | remove: '_' | remove: '-' | remove: ' ' -%}
    {%- assign payment_token = payment_key | prepend: '|' | append: '|' -%}
    {%- assign seen_payment_methods = seen_payment_methods | append: payment_token -%}
    <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
  {%- endfor -%}
  {%- for method in additional_payment_methods -%}
    {%- assign payment_label = method | strip -%}
    {%- assign payment_key = payment_label | downcase | remove: '_' | remove: '-' | remove: ' ' -%}
    {%- assign payment_token = payment_key | prepend: '|' | append: '|' -%}
    {%- if payment_label != blank -%}
      {%- unless seen_payment_methods contains payment_token -%}
        <li><span class="cart-payment-label">{{ payment_label | escape }}</span></li>
        {%- assign seen_payment_methods = seen_payment_methods | append: payment_token -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if payment_items != blank -%}
  <ul class="payment-icons" aria-label="Akzeptierte Zahlungsarten">{{ payment_items }}</ul>
{%- endif -%}

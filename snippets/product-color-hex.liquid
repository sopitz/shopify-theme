{%- comment -%}
  Echoes candidate when it is a #RGB, #RGBA, #RRGGBB or #RRGGBBAA string or
  colour metafield value; anything else echoes nothing.
{%- endcomment -%}
{%- liquid
  assign candidate_type = candidate | json | slice: 0
  if candidate_type == '"'
    assign hex_candidate = candidate | strip
    assign prefix = hex_candidate | slice: 0
    assign hex = hex_candidate | remove_first: '#' | downcase
    assign remainder = hex | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'a' | remove: 'b' | remove: 'c' | remove: 'd' | remove: 'e' | remove: 'f'
    if prefix == '#' and remainder == blank
      if hex.size == 3 or hex.size == 4 or hex.size == 6 or hex.size == 8
        echo hex_candidate
      endif
    endif
  endif
-%}

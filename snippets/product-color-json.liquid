{%- capture label -%}{% render 'product-color-label', color_product: product %}{%- endcapture -%}
{%- capture color -%}{% render 'product-color-value', color_product: product %}{%- endcapture -%}
{%- assign color = color | strip -%}
{%- capture colors -%}{% render 'product-color-values', color_product: product %}{%- endcapture -%}
{%- assign colors = colors | strip | split: '|' -%}
{%- capture json_escape -%}\u003c{%- endcapture -%}
{"id":{{ product.id | json }},"handle":{{ product.handle | json }},"title":{{ label | strip | json | replace: '<', json_escape }},"productTitle":{{ product.title | json | replace: '<', json_escape }},"url":{{ product.url | json }},"image":{% if product.featured_image %}{{ product.featured_image | image_url: width: 720 | json }}{% else %}null{% endif %},"color":{% if color != blank %}{{ color | json }}{% else %}null{% endif %},"colors":{{ colors | json }},"options":{% if product.options != blank %}{{ product.options | json }}{% else %}[]{% endif %},"variants":[{%- for variant in product.variants -%}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]}

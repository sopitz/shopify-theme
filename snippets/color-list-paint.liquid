{%- comment -%}
  CSS background for a colour dot from colours joined by "|": the single colour, or a
  circle divided into equal segments (first colour first, clockwise from the top).
{%- endcomment -%}
{%- assign paint_values = colors | strip | split: '|' -%}
{%- if paint_values.size > 1 -%}
  conic-gradient({% for paint_value in paint_values %}{% assign paint_stop = forloop.index | times: 100 | divided_by: forloop.length | floor %}{{ paint_value }} 0 {{ paint_stop }}%{% unless forloop.last %}, {% endunless %}{% endfor %})
{%- else -%}
  {{- paint_values.first -}}
{%- endif -%}

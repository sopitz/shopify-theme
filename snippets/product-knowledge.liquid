{%- comment -%}Every product statement comes from the current Shopify product or its published metafields.{%- endcomment -%}
{%- capture consultation_url -%}{%- render 'filial-anchor-url', url: consultation_url, fallback_url: '/pages/filialubersicht#Filialen' -%}{%- endcapture -%}
{%- assign consultation_url = consultation_url | strip -%}
{%- capture main_category -%}{% render 'product-main-category', product: product %}{%- endcapture -%}
{%- liquid
  assign main_category = main_category | strip
  assign everyday_eyebrow = 'Anwendung & Eignung'
  assign everyday_heading = 'Im Alltag.'
  assign everyday_nav = 'Alltag'
  assign suitability_heading = 'Für wen passend?'
  assign introduction_heading = 'Anwendung & Eingewöhnung'
  assign size_guide_heading = 'Grösse & Passform'
  assign care_heading = 'Pflege'
  assign faq_heading = 'Fragen & Antworten.'
  case main_category
    when 'footwear'
      assign everyday_nav = 'Gehgefühl'
      assign everyday_eyebrow = 'Gehgefühl & Eignung'
      assign suitability_heading = 'Für wen und wofür?'
      assign introduction_heading = 'Eingewöhnung'
      assign size_guide_heading = 'Passform und Grössenwahl'
      assign care_heading = 'Schuhpflege'
      assign faq_heading = 'Fragen zu diesem Modell.'
    when 'training'
      assign everyday_nav = 'Training'
      assign everyday_eyebrow = 'Training & Eignung'
      assign everyday_heading = 'Trainingsmöglichkeiten.'
      assign suitability_heading = 'Trainingsziel und Voraussetzungen'
      assign introduction_heading = 'Aufbau und erster Einsatz'
      assign size_guide_heading = 'Passende Ausführung auswählen'
      assign care_heading = 'Reinigung, Wartung und Aufbewahrung'
      assign faq_heading = 'Fragen zur Nutzung.'
    when 'regeneration'
      assign everyday_nav = 'Anwendung'
      assign everyday_heading = 'Nutzung im Alltag.'
      assign suitability_heading = 'Eignung und wichtige Einschränkungen'
      assign introduction_heading = 'Erste Anwendung'
      assign size_guide_heading = 'Passform und Kompatibilität'
      assign care_heading = 'Reinigung und Lagerung'
      assign faq_heading = 'Fragen zum Artikel.'
    when 'workplace'
      assign everyday_nav = 'Arbeitsalltag'
      assign everyday_eyebrow = 'Einsatz & Eignung'
      assign everyday_heading = 'Einbindung in den Arbeitstag.'
      assign suitability_heading = 'Passender Arbeitsplatz'
      assign introduction_heading = 'Aufstellung und Einrichtung'
      assign size_guide_heading = 'Passende Grösse und Ausführung'
      assign care_heading = 'Reinigung und Wartung'
      assign faq_heading = 'Fragen zum Arbeitsalltag.'
  endcase
-%}
{%- liquid
  assign features_field = product.metafields.upswing.features
  assign topics_field = product.metafields.upswing.everyday_topics
  assign faqs_field = product.metafields.upswing.faq_items
  assign information_features = features_field.value | compact
  assign information_topics = topics_field.value | compact
  assign information_facts = product.metafields.upswing.technical_specs.value | compact
  assign information_faqs = faqs_field.value | compact
  assign features_opening = features_field.value | json | slice: 0, 1
  assign topics_opening = topics_field.value | json | slice: 0, 1
  assign faqs_opening = faqs_field.value | json | slice: 0, 1
  if features_field.type == 'json' and features_opening != '['
    assign information_features = nil
  endif
  if topics_field.type == 'json' and topics_opening != '['
    assign information_topics = nil
  endif
  if faqs_field.type == 'json' and faqs_opening != '['
    assign information_faqs = nil
  endif
  assign knowledge_heading = 'Produkt verstehen.'
  assign heading_field = product.metafields.upswing.knowledge_heading
  assign heading_opening = heading_field.value | json | slice: 0, 1
  if heading_field.type == 'single_line_text_field' or heading_field.type == blank
    if heading_opening == '"'
      assign knowledge_heading = heading_field.value | strip | default: knowledge_heading
    endif
  endif
  assign knowledge_intro = ''
  assign intro_field = product.metafields.upswing.knowledge_intro
  assign intro_opening = intro_field.value | json | slice: 0, 1
  if intro_field.type == 'multi_line_text_field' or intro_field.type == 'single_line_text_field' or intro_field.type == blank
    if intro_opening == '"'
      assign knowledge_intro = intro_field.value | strip
    endif
  endif
  assign has_native_description = false
  if product.description != blank
    assign has_native_description = true
  endif
-%}
{%- capture short_description_content -%}{% render 'product-metafield-content', field: product.metafields.upswing.short_description %}{%- endcapture -%}
{%- capture suitability_content -%}{% render 'product-metafield-content', field: product.metafields.upswing.suitability %}{%- endcapture -%}
{%- capture specifications_content -%}{% render 'product-metafield-content', field: product.metafields.upswing.specifications %}{%- endcapture -%}
{%- capture faq_content -%}{% render 'product-metafield-content', field: product.metafields.upswing.faq %}{%- endcapture -%}
{%- capture testimonials_content -%}{% render 'product-metafield-content', field: product.metafields.upswing.testimonials %}{%- endcapture -%}
{%- liquid
  assign testimonials_content = testimonials_content | strip
  assign video_embed_url = ''
  assign video_field = product.metafields.upswing.video_url
  if video_field.type == 'single_line_text_field' or video_field.type == 'url' or video_field.type == blank
    assign video_opening = video_field.value | json | slice: 0, 1
    if video_opening == '"'
      assign video_url = video_field.value | strip
      assign video_id = ''
      if video_url contains 'youtube.com/embed/'
        assign video_id = video_url | split: 'youtube.com/embed/' | last
      elsif video_url contains 'youtube-nocookie.com/embed/'
        assign video_id = video_url | split: 'youtube-nocookie.com/embed/' | last
      elsif video_url contains 'youtu.be/'
        assign video_id = video_url | split: 'youtu.be/' | last
      elsif video_url contains 'youtube.com/watch'
        assign video_id = video_url | split: 'v=' | last
      elsif video_url contains 'vimeo.com/'
        assign vimeo_id = video_url | split: 'vimeo.com/' | last | split: '?' | first | split: '/' | last | strip
        assign vimeo_number = vimeo_id | plus: 0 | append: ''
        if vimeo_id != blank and vimeo_number == vimeo_id
          assign video_embed_url = 'https://player.vimeo.com/video/' | append: vimeo_id
        endif
      endif
      assign video_id = video_id | split: '?' | first | split: '&' | first | split: '/' | first | strip
      assign video_id_encoded = video_id | url_encode
      if video_id.size == 11 and video_id_encoded == video_id
        assign video_embed_url = 'https://www.youtube-nocookie.com/embed/' | append: video_id
      endif
    endif
  endif
-%}
{%- assign short_description_content = short_description_content | strip -%}
{%- assign suitability_content = suitability_content | strip -%}
{%- assign specifications_content = specifications_content | strip -%}
{%- assign faq_content = faq_content | strip -%}
{%- capture feature_cards -%}
  {%- for feature in information_features -%}
    {%- if features_field.type == 'json' -%}
      {%- assign feature_opening = feature | json | slice: 0, 1 -%}
      {%- unless feature_opening == '{' -%}{%- continue -%}{%- endunless -%}
      {%- assign feature_label_value = feature.label -%}
      {%- assign feature_title_value = feature.title -%}
      {%- capture feature_body -%}{% render 'product-json-html', html: feature.body %}{%- endcapture -%}
    {%- else -%}
      {%- assign feature_label_value = feature.label.value -%}
      {%- assign feature_title_value = feature.title.value -%}
      {%- capture feature_body -%}{% render 'product-metafield-content', field: feature.body %}{%- endcapture -%}
    {%- endif -%}
    {%- liquid
      assign feature_label = ''
      assign feature_title = ''
      assign feature_label_opening = feature_label_value | json | slice: 0, 1
      assign feature_title_opening = feature_title_value | json | slice: 0, 1
      if feature_label_opening == '"'
        assign feature_label = feature_label_value | replace: ' ', ' ' | strip
      endif
      if feature_title_opening == '"'
        assign feature_title = feature_title_value | replace: ' ', ' ' | strip
      endif
    -%}
    {%- assign feature_body = feature_body | strip -%}
    {%- if feature_title != blank and feature_body != blank -%}
      <article class="product-feature">
        <span class="product-feature-number"{% if feature_label == blank %} aria-hidden="true"{% endif %}>{% if feature_label != blank %}{{ feature_label | escape }}{% else %}{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}{% endif %}</span>
        {% if feature_title != blank %}<h3>{{ feature_title | escape }}</h3>{% endif %}
        {% if feature_body != blank %}<div class="product-knowledge-copy">{{ feature_body }}</div>{% endif %}
      </article>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign feature_cards = feature_cards | strip -%}
{%- capture everyday_cards -%}
  {%- for topic in information_topics -%}
    {%- if topics_field.type == 'json' -%}
      {%- assign topic_opening = topic | json | slice: 0, 1 -%}
      {%- unless topic_opening == '{' -%}{%- continue -%}{%- endunless -%}
      {%- assign topic_title_value = topic.title -%}
      {%- capture topic_body -%}{% render 'product-json-html', html: topic.body %}{%- endcapture -%}
    {%- else -%}
      {%- assign topic_title_value = topic.title.value -%}
      {%- capture topic_body -%}{% render 'product-metafield-content', field: topic.body %}{%- endcapture -%}
    {%- endif -%}
    {%- liquid
      assign topic_title = ''
      assign topic_title_opening = topic_title_value | json | slice: 0, 1
      if topic_title_opening == '"'
        assign topic_title = topic_title_value | replace: ' ', ' ' | strip
      endif
    -%}
    {%- assign topic_body = topic_body | strip -%}
    {%- if topic_title != blank and topic_body != blank -%}
      <article class="product-topic">{% if topic_title != blank %}<h3>{{ topic_title | escape }}</h3>{% endif %}{% if topic_body != blank %}<div class="rte product-knowledge-copy">{{ topic_body }}</div>{% endif %}</article>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign everyday_cards = everyday_cards | strip -%}
{%- capture technical_rows -%}
  {%- for fact in information_facts -%}
    {%- if fact.label.value != blank and fact.value.value != blank -%}<div><dt>{{ fact.label.value | escape }}</dt><dd>{{ fact.value.value | escape }}</dd></div>{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign technical_rows = technical_rows | strip -%}
{%- if technical_rows == blank -%}
  {%- capture technical_rows -%}{% render 'product-legacy-specs', product: product %}{%- endcapture -%}
  {%- assign technical_rows = technical_rows | strip -%}
{%- endif -%}
{%- capture practical_cards -%}
  {%- assign practical_keys = 'introduction,size_guide,care' | split: ',' -%}
  {%- for practical_key in practical_keys -%}
    {%- capture practical_body -%}{% render 'product-metafield-content', field: product.metafields.upswing[practical_key] %}{%- endcapture -%}
    {%- assign practical_body = practical_body | strip -%}
    {%- if practical_body != blank -%}<article{% if practical_key == 'size_guide' %} id="ProductSizeGuide"{% endif %}><h3>{% case practical_key %}{% when 'introduction' %}{{ introduction_heading }}{% when 'size_guide' %}{{ size_guide_heading }}{% when 'care' %}{{ care_heading }}{% endcase %}</h3><div class="rte product-knowledge-copy">{{ practical_body }}</div></article>{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign practical_cards = practical_cards | strip -%}
{%- capture faq_cards -%}
  {%- for faq in information_faqs -%}
    {%- if faqs_field.type == 'json' -%}
      {%- assign faq_opening = faq | json | slice: 0, 1 -%}
      {%- unless faq_opening == '{' -%}{%- continue -%}{%- endunless -%}
      {%- assign faq_question_value = faq.question -%}
      {%- capture faq_answer -%}{% render 'product-json-html', html: faq.answer %}{%- endcapture -%}
    {%- else -%}
      {%- assign faq_question_value = faq.question.value -%}
      {%- capture faq_answer -%}{% render 'product-metafield-content', field: faq.answer %}{%- endcapture -%}
    {%- endif -%}
    {%- liquid
      assign faq_question = ''
      assign faq_question_opening = faq_question_value | json | slice: 0, 1
      if faq_question_opening == '"'
        assign faq_question = faq_question_value | replace: ' ', ' ' | strip
      endif
    -%}
    {%- assign faq_answer = faq_answer | strip -%}
    {%- if faq_question != blank and faq_answer != blank -%}<details class="product-faq-item"><summary>{{ faq_question | escape }}<span aria-hidden="true">+</span></summary><div class="rte product-knowledge-copy">{{ faq_answer }}</div></details>{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign faq_cards = faq_cards | strip -%}
{%- liquid
  assign has_everyday_information = false
  if everyday_cards != blank or suitability_content != blank
    assign has_everyday_information = true
  endif
  assign has_practical_information = false
  if technical_rows != blank or specifications_content != blank or practical_cards != blank
    assign has_practical_information = true
  endif
  assign has_faq_information = false
  if faq_cards != blank or faq_content != blank
    assign has_faq_information = true
  endif
  assign has_structured_information = false
  if feature_cards != blank or has_everyday_information or has_practical_information or has_faq_information or testimonials_content != blank or video_embed_url != blank
    assign has_structured_information = true
  endif
  assign has_product_information = false
  if has_structured_information or has_native_description or knowledge_intro != blank or short_description_content != blank
    assign has_product_information = true
  endif
-%}
{%- if has_product_information -%}
  <section class="product-knowledge" id="ProductInformation" aria-labelledby="ProductInformationTitle">
    <div class="product-knowledge-heading">
      <p class="eyebrow">Gut informiert entscheiden</p>
      <h2 id="ProductInformationTitle">{{ knowledge_heading | escape }}</h2>
      {%- if knowledge_intro != blank -%}<p class="product-knowledge-lead">{{ knowledge_intro | escape | newline_to_br }}</p>{%- elsif short_description_content != blank -%}<div class="rte product-knowledge-lead">{{ short_description_content }}</div>{%- endif -%}
    </div>
    {%- if has_structured_information -%}
      <nav class="product-knowledge-nav" aria-label="Produktinformationen">
        {% if feature_cards != blank %}<a href="#ProductOverview">Überblick</a>{% endif %}
        {% if video_embed_url != blank %}<a href="#ProductVideo">Video</a>{% endif %}
        {% if has_everyday_information %}<a href="#ProductEveryday">{{ everyday_nav }}</a>{% endif %}
        {% if has_practical_information %}<a href="#ProductDetails">Details</a>{% endif %}
        {% if has_faq_information %}<a href="#ProductQuestions">Fragen</a>{% endif %}
        {% if testimonials_content != blank %}<a href="#ProductTestimonials">Stimmen</a>{% endif %}
        {% if has_native_description %}<a href="#ProductDescription">Produktbeschreibung</a>{% endif %}
      </nav>
    {%- endif -%}
    {%- if feature_cards != blank -%}<div class="product-feature-grid" id="ProductOverview">{{ feature_cards }}</div>{%- endif -%}
    {%- if video_embed_url != blank -%}
      <section class="product-video" id="ProductVideo">
        <div class="product-section-heading"><p class="eyebrow">Gezeigt und erklärt</p><h2>Das Produkt im Video.</h2></div>
        <div class="product-video-frame"><iframe src="{{ video_embed_url }}" title="Produktvideo: {{ product.title | escape }}" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe></div>
      </section>
    {%- endif -%}
    {%- if has_everyday_information -%}
      <section class="product-everyday" id="ProductEveryday">
        <div class="product-section-heading"><p class="eyebrow">{{ everyday_eyebrow }}</p><h2>{{ everyday_heading }}</h2></div>
        {% if everyday_cards != blank %}<div class="product-story-grid">{{ everyday_cards }}</div>{% endif %}
        {% if suitability_content != blank %}<div class="product-suitability"><h3>{{ suitability_heading }}</h3><div class="rte product-knowledge-copy">{{ suitability_content }}</div></div>{% endif %}
      </section>
    {%- endif -%}
    {%- if has_practical_information -%}
      <section class="product-detail-section" id="ProductDetails">
        <div class="product-section-heading"><p class="eyebrow">Vor dem Kauf gut informiert</p><h2>Die Details im Überblick.</h2></div>
        <div class="product-detail-grid">
          {% if technical_rows != blank or specifications_content != blank %}
            <article class="product-technical"><h3>Technische Details</h3>
              {% if technical_rows != blank %}<dl class="product-facts">{{ technical_rows }}</dl>{% endif %}
              {% if specifications_content != blank %}<div class="rte product-knowledge-copy">{{ specifications_content }}</div>{% endif %}
            </article>
          {% endif %}
          {% if practical_cards != blank %}<div class="product-practical">{{ practical_cards }}</div>{% endif %}
        </div>
      </section>
    {%- endif -%}
    {%- if has_faq_information -%}
      <section class="product-faq" id="ProductQuestions" aria-labelledby="ProductQuestionsTitle">
        <div class="product-section-heading"><p class="eyebrow">Die Antworten auf einen Blick</p><h2 id="ProductQuestionsTitle">{{ faq_heading }}</h2></div>
        <div class="product-faq-list">
          {{ faq_cards }}
          {% if faq_content != blank %}<details class="product-faq-item"><summary>Weitere Fragen & Antworten<span aria-hidden="true">+</span></summary><div class="rte product-knowledge-copy">{{ faq_content }}</div></details>{% endif %}
        </div>
      </section>
    {%- endif -%}
    {%- if testimonials_content != blank -%}
      <section class="product-testimonials" id="ProductTestimonials" aria-labelledby="ProductTestimonialsTitle">
        <div class="product-section-heading"><p class="eyebrow">Erfahrungen aus der Praxis</p><h2 id="ProductTestimonialsTitle">Kundenstimmen.</h2></div>
        <div class="rte product-knowledge-copy product-testimonials-copy">{{ testimonials_content }}</div>
      </section>
    {%- endif -%}
    {%- if has_native_description -%}
      <section class="product-native-information" id="ProductDescription">
        {% if has_structured_information %}<details class="product-native-description-details"><summary>Vollständige Produktbeschreibung</summary>{% endif %}
        <article class="rte product-native-description" data-native-product-description>{{ product.description }}</article>
        {% if has_structured_information %}</details>{% endif %}
      </section>
    {%- endif -%}
    <footer class="product-help-band"><div><h3>Noch eine Frage offen?</h3><p>Besprechen Sie Ihre Auswahl persönlich mit unserem Beratungsteam.</p></div><a class="button light" href="{{ consultation_url | escape }}">Beratung finden</a></footer>
  </section>
{%- endif -%}

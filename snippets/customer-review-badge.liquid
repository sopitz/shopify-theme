{%- assign reviews_url = settings.reviews_url | default: 'https://share.google/rq63tyE1ku834ANfK' -%}
<upswing-reviews class="review-badge review-badge--{{ placement | escape }}" data-widget-id="{{ settings.reviews_widget_id | default: 'mt0kalx0rn3kuz7uwle88avzlqbigvq6yttlqkoc' | escape }}">
  <a class="review-badge-link" href="{{ reviews_url | escape }}" target="_blank" rel="noopener noreferrer">
    <span class="review-badge-summary">
      <span class="review-badge-fallback" data-review-fallback>Google-Bewertungen ansehen</span>
      <span class="review-badge-rating" data-review-rating hidden>
        <span class="sr-only" data-review-label></span>
        <span class="review-badge-score" aria-hidden="true"><strong data-review-score></strong><span class="review-badge-max"> / 5</span></span>
        <span class="customer-reviews-stars" aria-hidden="true"><span>★★★★★</span><span data-review-stars>★★★★★</span></span>
      </span>
      <span class="review-badge-count" data-review-count hidden></span>
    </span>
    {% if placement == 'header' %}{% render 'icon', name: 'arrow' %}{% endif %}
    <span class="sr-only"> (öffnet Google-Bewertungen in neuem Tab)</span>
  </a>
  <a class="customer-reviews-attribution" href="https://reviewsplugin.com/" target="_blank" rel="noopener noreferrer" data-review-attribution hidden>Reviews by ReviewsPlugin<span class="sr-only"> (öffnet in neuem Tab)</span></a>
</upswing-reviews>

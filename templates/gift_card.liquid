{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    {% render 'theme-colors' %}
    <title>Dein Geschenkgutschein · {{ shop.name | escape }}</title>
    {{ content_for_header }}
    {{ 'upswing.css' | asset_url | stylesheet_tag }}
    {{ 'theme-components.css' | asset_url | stylesheet_tag }}
    {{ 'typography.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-gift-card">
    <main id="MainContent" class="section-space">
      <div class="container page-width gift-card-page">
        <a href="{{ shop.url }}"><img src="{{ 'upswing-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="180" height="52"></a>
        <p class="eyebrow">ETWAS GUTES SCHENKEN</p>
        <h1>Dein Geschenkgutschein.</h1>
        <div class="gift-card-panel">
          <p>Verfügbares Guthaben</p>
          <p class="gift-card-amount">{{ gift_card.balance | money_with_currency }}</p>
          {% if gift_card.enabled == false or gift_card.expired %}
            <p role="status">Dieser Gutschein kann derzeit nicht eingelöst werden.</p>
          {% else %}
            <label for="GiftCardCode">Dein Gutscheincode</label>
            <input id="GiftCardCode" class="gift-card-code" type="text" value="{{ gift_card.code | format_code }}" readonly aria-describedby="GiftCardHelp">
            <p id="GiftCardHelp">Gib diesen Code beim Bezahlen ein. Bewahre deinen Gutschein sicher auf.</p>
            {% if gift_card.expires_on %}<p>Gültig bis {{ gift_card.expires_on | date: '%d.%m.%Y' }}.</p>{% endif %}
            {% if gift_card.pass_url %}<a class="text-link" href="{{ gift_card.pass_url }}">In Apple Wallet speichern</a>{% endif %}
          {% endif %}
        </div>
        <a class="button" href="{{ shop.url }}">Sortiment entdecken {% render 'icon', name: 'arrow' %}</a>
      </div>
    </main>
  </body>
</html>

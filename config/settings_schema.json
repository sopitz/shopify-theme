[
  {
    "name": "theme_info",
    "theme_name": "Upswing Wellbeing",
    "theme_version": "1.0.10",
    "theme_author": "Upswing",
    "theme_documentation_url": "https://upswing.ch",
    "theme_support_url": "https://upswing.ch/pages/kontakt"
  },
  {
    "name": "Logo & Kontakt",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (Original Upswing-Logo)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logobreite",
        "default": 180,
        "min": 120,
        "max": 240,
        "step": 10,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Telefonnummer"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "E-Mail-Adresse"
      }
    ]
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "color",
        "id": "color_forest",
        "label": "Primärfarbe · Buttons und Auswahl",
        "default": "#0078a8"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Heller Hintergrund",
        "default": "#f4f7f9"
      },
      {
        "type": "color",
        "id": "color_sage",
        "label": "Hellblaue Flächen",
        "default": "#eaf5fa"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text und dunkle Flächen",
        "default": "#1d1d1b"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Logo-Akzent",
        "default": "#0088c0"
      },
      {
        "type": "color",
        "id": "color_link",
        "label": "Links und Fokus",
        "default": "#006f9e"
      }
    ]
  },
  {
    "name": "Modellkatalog",
    "settings": [
      {
        "type": "checkbox",
        "id": "group_model_search",
        "label": "Suche nach Produktmodellen gruppieren",
        "default": false,
        "info": "Erst aktivieren, wenn jedes Produkt model_primary gepflegt hat und der boolean Filter upswing.model_primary in Search & Discovery eingerichtet ist. Sonst fehlen Produkte."
      },
      {
        "type": "textarea",
        "id": "model_search_filter_parameters",
        "label": "Erlaubte Modellfilter in der Suche",
        "default": "filter.p.vendor,filter.p.product_type,filter.p.m.upswing.model_colors",
        "info": "Kommagetrennte Parameternamen. Preis, Grösse und Lager nur freigeben, wenn diese Daten für das gesamte Modell zuverlässig gepflegt werden."
      }
    ]
  }
]

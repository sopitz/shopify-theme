<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% render 'theme-colors' %}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{%- endif -%}
    <title>{{ page_title }}{% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} · Seite {{ current_page }}{% endif %}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
    {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    {{ content_for_header }}
    {{ 'upswing.css' | asset_url | stylesheet_tag }}
    {{ 'theme-components.css' | asset_url | stylesheet_tag }}
    {{ 'commerce-components.css' | asset_url | stylesheet_tag }}
    {{ 'need-topics.css' | asset_url | stylesheet_tag }}
    {{ 'product-information.css' | asset_url | stylesheet_tag }}
    {{ 'product-knowledge.css' | asset_url | stylesheet_tag }}
    {{ 'typography.css' | asset_url | stylesheet_tag }}
    {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
    {{ 'about-pages.css' | asset_url | stylesheet_tag }}
    {{ 'contact-locations.css' | asset_url | stylesheet_tag }}
    {{ 'product-media-context.css' | asset_url | stylesheet_tag }}
    {{ 'quantity-stepper.css' | asset_url | stylesheet_tag }}
    {{ 'row-alignment.css' | asset_url | stylesheet_tag }}
    {{ 'product-cards.css' | asset_url | stylesheet_tag }}
    {{ 'color-swatches.css' | asset_url | stylesheet_tag }}
    {{ 'predictive-search.css' | asset_url | stylesheet_tag }}
    {{ 'manrope-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <script>document.documentElement.classList.replace('no-js','js');</script>
    <script src="{{ 'filial-links.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'contact-locations.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'featured-products.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'upswing.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quantity-stepper.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'legacy-colors.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'gallery-image-preload.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-cards.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-media-context.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-color-prefetch.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}{% if settings.logo != blank %},"logo":{{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif %}}</script>
  </head>
  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">Zum Inhalt springen</a>
    {% section 'header' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'footer' %}
    <div class="sr-only" role="status" aria-live="polite" data-live-region></div>
  </body>
</html>

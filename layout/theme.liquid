<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% render 'theme-colors' %}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32 }}">{%- endif -%}
    {%- liquid
      assign seo_suffix = settings.seo_title_suffix | default: shop.name
      assign seo_description = page_description
      if seo_description == blank
        case request.page_type
          when 'product'
            assign seo_description = product.description | strip_html
          when 'collection'
            assign seo_description = collection.description | strip_html
          when 'page'
            assign seo_description = page.content | strip_html
          when 'article'
            assign seo_description = article.excerpt_or_content | strip_html
        endcase
      endif
      if seo_description == blank
        assign seo_description = settings.seo_default_description
      endif
      assign seo_description = seo_description | strip_newlines | replace: '  ', ' ' | strip | truncate: 155
      assign seo_noindex = false
      if request.page_type == 'search'
        assign seo_noindex = true
      elsif collection.handle == 'vendors'
        assign seo_noindex = true
      elsif collection.handle == 'types'
        assign seo_noindex = true
      endif
      assign seo_crumb_name = ''
      assign seo_crumb_url = ''
      case request.page_type
        when 'product'
          assign seo_crumb_name = product.title
          assign seo_crumb_url = product.url
        when 'collection'
          assign seo_crumb_name = collection.title
          assign seo_crumb_url = collection.url
        when 'page'
          assign seo_crumb_name = page.title
          assign seo_crumb_url = page.url
        when 'article'
          assign seo_crumb_name = article.title
          assign seo_crumb_url = article.url
        when 'blog'
          assign seo_crumb_name = blog.title
          assign seo_crumb_url = blog.url
      endcase
      assign seo_same_as = settings.seo_same_as | strip | newline_to_br | strip_newlines | split: '<br />'
    -%}
    <title>{{ page_title }}{% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} · Seite {{ current_page }}{% endif %}{% unless page_title contains seo_suffix or page_title contains shop.name %} · {{ seo_suffix }}{% endunless %}</title>
    {% if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
    {% if seo_noindex %}<meta name="robots" content="noindex, follow">{% endif %}
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
    {% if seo_description != blank %}<meta property="og:description" content="{{ seo_description | escape }}">{% endif %}
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    {{ content_for_header }}
    {{ 'upswing.css' | asset_url | stylesheet_tag }}
    {{ 'theme-components.css' | asset_url | stylesheet_tag }}
    {{ 'commerce-components.css' | asset_url | stylesheet_tag }}
    {{ 'need-topics.css' | asset_url | stylesheet_tag }}
    {{ 'product-information.css' | asset_url | stylesheet_tag }}
    {{ 'product-knowledge.css' | asset_url | stylesheet_tag }}
    {{ 'typography.css' | asset_url | stylesheet_tag }}
    {{ 'mega-menu.css' | asset_url | stylesheet_tag }}
    {{ 'about-pages.css' | asset_url | stylesheet_tag }}
    {{ 'contact-locations.css' | asset_url | stylesheet_tag }}
    {{ 'product-media-context.css' | asset_url | stylesheet_tag }}
    {{ 'quantity-stepper.css' | asset_url | stylesheet_tag }}
    {{ 'row-alignment.css' | asset_url | stylesheet_tag }}
    {{ 'product-cards.css' | asset_url | stylesheet_tag }}
    {{ 'color-swatches.css' | asset_url | stylesheet_tag }}
    {{ 'predictive-search.css' | asset_url | stylesheet_tag }}
    {{ 'customer-reviews.css' | asset_url | stylesheet_tag }}
    {{ 'sticky-header.css' | asset_url | stylesheet_tag }}
    {{ 'manrope-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    <script>document.documentElement.classList.replace('no-js','js');</script>
    <script src="{{ 'filial-links.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'contact-locations.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'featured-products.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'upswing.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quantity-stepper.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'legacy-colors.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'gallery-image-preload.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-cards.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-media-context.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-color-prefetch.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'customer-reviews.js' | asset_url }}" defer="defer"></script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ shop.name | json }},"url":{{ shop.url | json }}{% if settings.logo != blank %},"logo":{{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif %}{% if settings.contact_phone != blank %},"telephone":{{ settings.contact_phone | json }}{% endif %}{% if settings.contact_email != blank %},"email":{{ settings.contact_email | json }}{% endif %}{% if settings.seo_same_as != blank %},"sameAs":{{ seo_same_as | json }}{% endif %}}</script>
    {%- if seo_crumb_name != blank -%}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Startseite","item":{{ shop.url | json }}}{% if request.page_type == 'product' and collection.title != blank %},{"@type":"ListItem","position":2,"name":{{ collection.title | json }},"item":{{ collection.url | prepend: shop.url | json }}},{"@type":"ListItem","position":3,"name":{{ seo_crumb_name | json }},"item":{{ seo_crumb_url | prepend: shop.url | json }}}{% elsif request.page_type == 'article' %},{"@type":"ListItem","position":2,"name":{{ blog.title | json }},"item":{{ blog.url | prepend: shop.url | json }}},{"@type":"ListItem","position":3,"name":{{ seo_crumb_name | json }},"item":{{ seo_crumb_url | prepend: shop.url | json }}}{% else %},{"@type":"ListItem","position":2,"name":{{ seo_crumb_name | json }},"item":{{ seo_crumb_url | prepend: shop.url | json }}}{% endif %}]}</script>
    {%- endif -%}
  </head>
  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#MainContent">Zum Inhalt springen</a>
    {% section 'header' %}
    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'footer' %}
    <div class="sr-only" role="status" aria-live="polite" data-live-region></div>
  </body>
</html>
